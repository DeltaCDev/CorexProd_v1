<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.OciDetallePage"
             Title="Orden de Compra"
             BackgroundColor="#F4F6F8">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="14">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="ProductosTabButton"
                        Text="Productos"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="#3F1D95"
                        BorderColor="#3F1D95"
                        BorderWidth="1"
                        TextColor="White"
                        Clicked="OnProductosTabClicked" />
                <Button x:Name="OtsTabButton"
                        Grid.Column="1"
                        Text="OT relacionadas"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="White"
                        BorderColor="#D9E0E6"
                        BorderWidth="1"
                        TextColor="#344054"
                        Clicked="OnOtsTabClicked" />
            </Grid>

            <Border x:Name="ProductosSection" Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Orden de Compra"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="#101828"
                               VerticalOptions="Center" />

                        <Border x:Name="EstadoBadge" Grid.Column="1" Padding="12,5" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label x:Name="EstadoLabel" FontFamily="OpenSansSemibold" FontSize="12" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cliente" FontSize="12" TextColor="#3F1D95" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Cliente:"
                                   FontSize="14"
                                   TextColor="#667085"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label x:Name="ClienteLabel"
                                   Grid.Column="1"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="#101828"
                                   LineBreakMode="WordWrap" />
                            <Border Grid.Column="2"
                                    Padding="8,3"
                                    BackgroundColor="#F3F0FF"
                                    Stroke="#E4D7FF"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="OC:"
                                           FontSize="12"
                                           TextColor="#3F1D95" />
                                    <Label x:Name="OcClienteDestacadoLabel"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#3F1D95"
                                           LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EAECF0" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fecha Emisión" FontSize="12" TextColor="#3F1D95" />
                            <Label x:Name="FechaEmisionLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="#101828" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Fecha Entrega" FontSize="12" TextColor="#3F1D95" />
                            <Label x:Name="FechaEntregaLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="#101828" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="TiempoRestanteBadge"
                            Padding="10,6"
                            BackgroundColor="#F8FAFC"
                            Stroke="#D9E0E6"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Entrega:"
                                   FontSize="12"
                                   TextColor="#667085" />
                            <Label x:Name="TiempoRestanteLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="#101828" />
                        </HorizontalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1" Color="#EAECF0" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="OC Interna:" FontSize="13" TextColor="#3F1D95" />
                        <Label x:Name="NumeroLabel" Grid.Column="1" FontSize="13" TextColor="#344054" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="OtsSection" Padding="14" BackgroundColor="White" Stroke="#D9E0E6" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="OtsTituloLabel"
                           Text="OT relacionadas"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           TextColor="#101828" />

                    <Label x:Name="OtsVacioLabel"
                           Text="No hay OT relacionadas para esta OC."
                           FontSize="13"
                           TextColor="#667085"
                           IsVisible="False" />

                    <VerticalStackLayout x:Name="OtsLayout"
                                         Spacing="12"
                                         BindableLayout.ItemsSource="{Binding OtsRelacionadas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="13" BackgroundColor="White" Stroke="#D9E0E6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding NumeroOT}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16"
                                                       TextColor="#101828" />
                                                <Label Text="{Binding TipoOT}"
                                                       FontSize="12"
                                                       TextColor="#667085" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
                                                    Padding="8,3"
                                                    BackgroundColor="{Binding EstadoBackgroundColor}"
                                                    Stroke="{Binding EstadoStrokeColor}"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Estado}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="{Binding EstadoTextColor}" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Avance" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding AvanceTexto}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="#344054" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Productos" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding ProductosTexto}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="#344054" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Button Text="Ver detalle"
                                                BackgroundColor="#3F1D95"
                                                TextColor="White"
                                                FontFamily="OpenSansSemibold"
                                                Clicked="OnVerOtClicked" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="ProductosTituloLabel"
                           Text="Productos"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           TextColor="#101828" />

                    <VerticalStackLayout x:Name="ProductosLayout"
                                         Spacing="12"
                                         BindableLayout.ItemsSource="{Binding Productos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="13" BackgroundColor="White" Stroke="#D9E0E6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Border Padding="9,4"
                                                    BackgroundColor="#F3F0FF"
                                                    Stroke="#E4D7FF"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding CodigoProducto}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="#3F1D95" />
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding CantidadTexto}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17"
                                                   TextColor="#3F1D95"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>

                                        <Label Text="{Binding NombreProducto}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="#101828"
                                               LineBreakMode="WordWrap"
                                               MaxLines="3" />

                                        <VerticalStackLayout IsVisible="{Binding MostrarDisponibilidad}" Spacing="7">
                                            <BoxView HeightRequest="1" Color="#EAECF0" />
                                            <Label Text="Disponibilidad" FontSize="13" TextColor="#3F1D95" />
                                            <ProgressBar Progress="{Binding ProgresoDisponibilidad}"
                                                         ProgressColor="#22A51B"
                                                         BackgroundColor="#E5E7EB"
                                                         HeightRequest="8" />
                                            <Label Text="{Binding DisponibilidadResumenTexto}"
                                                   FontSize="12"
                                                   TextColor="#667085" />

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <HorizontalStackLayout Spacing="7">
                                                    <Ellipse WidthRequest="9"
                                                             HeightRequest="9"
                                                             Fill="{Binding StockIndicadorColor}"
                                                             VerticalOptions="Center" />
                                                    <Label Text="{Binding StockDisponibleTexto}"
                                                           FontSize="13"
                                                           TextColor="{Binding StockTextoColor}"
                                                           LineBreakMode="WordWrap" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Grid.Column="1"
                                                                       Spacing="7"
                                                                       IsVisible="{Binding TieneFaltante}">
                                                    <Ellipse WidthRequest="9"
                                                             HeightRequest="9"
                                                             Fill="#E11D48"
                                                             VerticalOptions="Center" />
                                                    <Label Text="{Binding FaltanteTexto}"
                                                           FontSize="13"
                                                           TextColor="#E11D48"
                                                           LineBreakMode="WordWrap" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <Border Padding="10" BackgroundColor="#F8FAFC" Stroke="#EEF2F6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Observación" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding ObservacionTexto}"
                                                       FontSize="13"
                                                       TextColor="#475467"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Observación General"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#101828" />
                    <Border Padding="12" BackgroundColor="#F8FAFC" Stroke="#EEF2F6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label x:Name="ObservacionGeneralLabel"
                               TextColor="#475467"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Resumen"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           TextColor="#101828" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="11"
                          ColumnSpacing="12">
                        <Label Text="Subtotal" TextColor="#344054" />
                        <Label x:Name="SubtotalLabel" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Label Grid.Row="1" Text="IGV (18%)" TextColor="#344054" />
                        <Label x:Name="IgvLabel" Grid.Row="1" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Label Grid.Row="2" Text="Descuento" TextColor="#344054" />
                        <Label x:Name="DescuentoLabel" Grid.Row="2" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Border Grid.Row="3" Grid.ColumnSpan="2" Padding="12" BackgroundColor="#F3F0FF" Stroke="#D8C8FF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="TOTAL"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       TextColor="#3F1D95"
                                       VerticalOptions="Center" />
                                <Label x:Name="TotalLabel"
                                       Grid.Column="1"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="28"
                                       TextColor="#3F1D95"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,14">
                <Button Text="Descargar PDF"
                        BackgroundColor="White"
                        BorderColor="#3F1D95"
                        BorderWidth="1"
                        TextColor="#3F1D95"
                        Clicked="OnDescargarPdfClicked" />
                <Button Grid.Column="1"
                        Text="Compartir"
                        BackgroundColor="#3F1D95"
                        TextColor="White"
                        Clicked="OnCompartirClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
