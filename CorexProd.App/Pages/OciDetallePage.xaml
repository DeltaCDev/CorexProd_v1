<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.OciDetallePage"
             Title="Orden de Compra"
             BackgroundColor="#F4F6F8">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="NumeroLabel" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#101828" />
                            <Label x:Name="FechaCreacionLabel" FontSize="13" TextColor="#667085" />
                        </VerticalStackLayout>

                        <Border x:Name="EstadoBadge" Grid.Column="1" Padding="12,5" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label x:Name="EstadoLabel" FontFamily="OpenSansSemibold" FontSize="12" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EAECF0" />

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Cliente" FontSize="12" TextColor="#3F1D95" />
                            <Label x:Name="ClienteLabel" FontFamily="OpenSansSemibold" FontSize="17" TextColor="#101828" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                            <Label Text="Fecha de Emisión" FontSize="12" TextColor="#3F1D95" HorizontalTextAlignment="End" />
                            <Label x:Name="FechaEmisionLabel" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#101828" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="OcClienteContainer" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                            <Label Text="OC Cliente" FontSize="12" TextColor="#667085" />
                            <Label x:Name="OcClienteLabel" FontSize="14" TextColor="#344054" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Resumen" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#101828" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="12">
                        <Label Text="Subtotal" TextColor="#344054" />
                        <Label x:Name="SubtotalLabel" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Label Grid.Row="1" Text="IGV (18%)" TextColor="#344054" />
                        <Label x:Name="IgvLabel" Grid.Row="1" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Label Grid.Row="2" Text="Descuento" TextColor="#344054" />
                        <Label x:Name="DescuentoLabel" Grid.Row="2" Grid.Column="1" TextColor="#101828" HorizontalTextAlignment="End" />

                        <Border Grid.Row="3" Grid.ColumnSpan="2" Padding="10" BackgroundColor="#F3F0FF" Stroke="#E4D7FF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="TOTAL" FontFamily="OpenSansSemibold" TextColor="#3F1D95" VerticalOptions="Center" />
                                <Label x:Name="TotalLabel" Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="22" TextColor="#3F1D95" HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ProductosTituloLabel" Text="Productos" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#101828" />
                    <VerticalStackLayout x:Name="ProductosLayout" Spacing="10" BindableLayout.ItemsSource="{Binding Productos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" BackgroundColor="White" Stroke="#D9E0E6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding CodigoProducto}" FontSize="13" TextColor="#667085" />
                                        <Label Text="{Binding NombreProducto}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="#101828" LineBreakMode="WordWrap" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Cantidad" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding CantidadTexto}" FontSize="16" TextColor="#101828" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="Total" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding TotalTexto}" FontSize="16" TextColor="#101828" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border Padding="10" BackgroundColor="#F8FAFC" Stroke="#EEF2F6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Observación" FontSize="12" TextColor="#3F1D95" />
                                                <Label Text="{Binding ObservacionTexto}" FontSize="13" TextColor="#475467" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="White" Stroke="#D9E0E6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Observación General" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#101828" />
                    <Border Padding="12" BackgroundColor="#F8FAFC" Stroke="#EEF2F6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="ObservacionGeneralLabel" TextColor="#475467" LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,14">
                <Button Text="Descargar PDF"
                        BackgroundColor="White"
                        BorderColor="#3F1D95"
                        BorderWidth="1"
                        TextColor="#3F1D95"
                        Clicked="OnDescargarPdfClicked" />
                <Button Grid.Column="1"
                        Text="Enviar / Compartir"
                        BackgroundColor="#3F1D95"
                        TextColor="White"
                        Clicked="OnCompartirClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
