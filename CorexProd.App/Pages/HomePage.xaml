<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.HomePage"
             Title="Inicio"
             BackgroundColor="#F8FAFC">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E2E8F0" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="12" />
            </Setter>
        </Style>
        <Style x:Key="Title" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#111827" />
        </Style>
        <Style x:Key="Small" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#475569" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F8FAFC">
        <Grid Padding="18,20,18,18"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12"
              BackgroundColor="#4F2FD7">
            <Button Text="&#x2630;"
                    FontSize="30"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="42"
                    Clicked="OnToggleMenuClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Panel principal" FontSize="22" FontFamily="OpenSansSemibold" TextColor="White" />
                <Label Text="Resumen operativo" FontSize="15" TextColor="White" />
            </VerticalStackLayout>
            <Grid Grid.Column="2" WidthRequest="48" HeightRequest="48">
                <Button Text="&#x1F514;"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Clicked="OnBellClicked" />
                <Border x:Name="AlertBadge"
                        BackgroundColor="#EF233C"
                        StrokeThickness="0"
                        Padding="5,1"
                        HorizontalOptions="End"
                        VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label x:Name="AlertCountLabel" Text="0" FontSize="10" FontFamily="OpenSansSemibold" TextColor="White" />
                </Border>
            </Grid>
            <Button Grid.Column="3"
                    Text="&#x25CE;"
                    FontSize="32"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="44"
                    Clicked="OnLogoutClicked" />
        </Grid>

        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="14,14,14,18" Spacing="14">
                    <Border Style="{StaticResource Card}" BackgroundColor="#F3F0FF" Stroke="#E7E0FF">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#E8E2FF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="23" />
                                </Border.StrokeShape>
                                <Label Text="&#x1F4C5;" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Periodo actual" Style="{StaticResource Small}" />
                                <Label x:Name="PeriodoLabel" Text="Este mes" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#x2304;" FontSize="26" TextColor="#334155" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <CollectionView x:Name="KpiView" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" HeightRequest="130">
                                    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
                                        <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{Binding SoftColor}" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="22" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icono}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Valor}" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Titulo}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Comparacion}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Seguimiento de fechas de entrega" Style="{StaticResource Title}" />
                                    <Label Text="Ordenes proximas a vencer" Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Ver todas >"
                                        FontSize="13"
                                        TextColor="#4F2FD7"
                                        BackgroundColor="Transparent"
                                        BorderColor="#C8BFFF"
                                        BorderWidth="1"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Clicked="OnBellClicked" />
                            </Grid>

                            <CollectionView x:Name="EntregaResumenView" SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="7" VerticalItemSpacing="7" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" BackgroundColor="{Binding Background}" StrokeThickness="0" HeightRequest="88">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Valor}" FontSize="21" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="11" TextColor="#111827" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Subtitulo}" FontSize="10" TextColor="#111827" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="Ordenes mas urgentes" Style="{StaticResource Small}" />
                            <CollectionView x:Name="UrgentesView" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label Text="Sin OC vencidas o proximas." Padding="10" TextColor="#64748B" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,9" ColumnDefinitions="18,*,Auto,Auto" ColumnSpacing="9">
                                            <Ellipse WidthRequest="12" HeightRequest="12" Fill="{Binding Brush}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding NumeroOci}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="#0F172A" />
                                                <Label Text="{Binding Cliente}" FontSize="12" TextColor="#334155" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2" WidthRequest="138">
                                                <Label Text="{Binding EstadoTexto}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" />
                                                <Label Text="{Binding FechaEntregaTexto}" FontSize="12" TextColor="#334155" />
                                                <Label Text="{Binding AlertaTexto}" FontSize="12" TextColor="{Binding Color}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="3" Text=">" FontSize="24" TextColor="#1E293B" BackgroundColor="Transparent" Padding="0" Clicked="OnVerAlertaClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Ordenes de Compra" Style="{StaticResource Title}" />
                                    <Label Grid.Column="1" Text="OC" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#4F2FD7" />
                                </Grid>
                                <CollectionView x:Name="OcResumenView" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="3" VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Valor}" FontSize="20" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="11" TextColor="#334155" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Ver todas las OC >" FontSize="13" TextColor="#4F2FD7" BackgroundColor="Transparent" Clicked="OnOciClicked" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Ordenes de Trabajo" Style="{StaticResource Title}" />
                                    <Label Grid.Column="1" Text="OT" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#16A34A" />
                                </Grid>
                                <CollectionView x:Name="OtResumenView" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="3" VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Valor}" FontSize="20" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="11" TextColor="#334155" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Ver todas las OT >" FontSize="13" TextColor="#4F2FD7" BackgroundColor="Transparent" Clicked="OnOrdenesTrabajoClicked" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Top 5 productos mas elaborados" Style="{StaticResource Title}" />
                                <Label Grid.Column="1" Text="|||" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#4F2FD7" />
                            </Grid>
                            <CollectionView x:Name="TopProductosView" SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <Label Text="Sin productos elaborados este mes." Padding="10" TextColor="#64748B" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7" ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                                            <Border WidthRequest="24" HeightRequest="24" BackgroundColor="#EEF2FF" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Posicion}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#4F2FD7" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="12" TextColor="#334155" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Cantidad}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#0F172A" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="ApiStatusLabel" Text="Conectando..." FontSize="11" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label x:Name="LastUpdateLabel" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" BackgroundColor="White" Padding="4,8,4,8">
            <Button Text="Inicio" TextColor="#4F2FD7" BackgroundColor="Transparent" FontSize="12" />
            <Button Grid.Column="1" Text="OC" TextColor="#64748B" BackgroundColor="Transparent" FontSize="12" Clicked="OnOciClicked" />
            <Button Grid.Column="2" Text="+ Nueva OC" TextColor="White" BackgroundColor="#4F2FD7" CornerRadius="24" FontSize="13" Clicked="OnNuevaOcClicked" />
            <Button Grid.Column="3" Text="OT" TextColor="#64748B" BackgroundColor="Transparent" FontSize="12" Clicked="OnOrdenesTrabajoClicked" />
            <Button Grid.Column="4" Text="Mas" TextColor="#64748B" BackgroundColor="Transparent" FontSize="12" Clicked="OnToggleMenuClicked" />
        </Grid>

        <Grid x:Name="AlertOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#99000000" Padding="18,90,18,20">
            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Notificaciones de entrega" Style="{StaticResource Title}" />
                        <Button Grid.Column="1" Text="X" FontSize="18" BackgroundColor="Transparent" Clicked="OnCloseAlertsClicked" />
                    </Grid>
                    <CollectionView x:Name="AlertasView" SelectionMode="None" MaximumHeightRequest="520">
                        <CollectionView.EmptyView>
                            <Label Text="Sin alertas de entrega." Padding="12" TextColor="#64748B" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,9" ColumnDefinitions="14,*,Auto" ColumnSpacing="9">
                                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding Brush}" VerticalOptions="Start" Margin="0,5,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding NumeroOci}" FontFamily="OpenSansSemibold" TextColor="#0F172A" />
                                        <Label Text="{Binding Cliente}" FontSize="12" TextColor="#334155" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding EstadoTexto}" FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding FechaEntregaTexto}" FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding AlertaTexto}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Ver" FontSize="12" Padding="8,3" BackgroundColor="#EEF2FF" TextColor="#4F2FD7" Clicked="OnVerAlertaClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="MenuDrawerOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#80000000" ColumnDefinitions="285,*">
            <Border BackgroundColor="#071F32" StrokeThickness="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <VerticalStackLayout Padding="18,22,18,14" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="CorexProd" FontFamily="OpenSansSemibold" FontSize="21" TextColor="White" />
                                <Label x:Name="DrawerUserLabel" FontSize="12" TextColor="#BFD7EA" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="X" FontSize="18" TextColor="White" BackgroundColor="Transparent" Clicked="OnCloseMenuClicked" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#21465F" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                    <CollectionView Grid.Row="1" x:Name="ModuleMenuView" SelectionMode="Single" SelectionChanged="OnModuleMenuSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,10" ColumnDefinitions="34,*" ColumnSpacing="10">
                                    <Label Text="{Binding Icono}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="White" />
                                        <Label Text="{Binding Grupo}" FontSize="11" TextColor="#9EC6DD" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Row="2" Margin="18,12,18,20" Text="Cerrar sesion" TextColor="White" BackgroundColor="#EF4444" CornerRadius="10" Clicked="OnLogoutClicked" />
                </Grid>
            </Border>
            <Button Grid.Column="1" BackgroundColor="Transparent" Clicked="OnCloseMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
