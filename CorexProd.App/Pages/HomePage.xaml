<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.HomePage"
             Title="Inicio"
             BackgroundColor="#F6F7FB">
    <ContentPage.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E3E7EF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="16" />
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="#111827" />
        </Style>

        <Style x:Key="SmallText" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#6B7280" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F6F7FB">
        <Grid Grid.Row="0"
              Padding="12,12,14,12"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="10"
              BackgroundColor="#512BD4">
            <Button Text="☰"
                    FontSize="25"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="6,0"
                    WidthRequest="46"
                    HeightRequest="42"
                    Clicked="OnToggleMenuClicked" />
            <Label Grid.Column="1"
                   Text="CorexProd"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="🔔"
                   FontSize="20"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Button Grid.Column="3"
                    Text="⋮"
                    FontSize="22"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnLogoutClicked" />
        </Grid>

        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,18" Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="¡Bienvenido, Admin!"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="21"
                                   TextColor="#111827" />
                            <Label x:Name="UserLabel"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   LineBreakMode="TailTruncation" />
                            <Label x:Name="RoleLabel"
                                   FontSize="11"
                                   TextColor="#8A94A6"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E3E7EF"
                                Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="PERIODO" FontSize="9" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                                <Label x:Name="PeriodoLabel" Text="Este mes" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#512BD4" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image x:Name="CompanyLogo"
                                   Source="logo.png"
                                   WidthRequest="58"
                                   HeightRequest="58"
                                   Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label x:Name="CompanyNameLabel"
                                       Text="CorexProd"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="#111827"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="ApiStatusLabel"
                                       Text="Conectando..."
                                       FontSize="11"
                                       TextColor="#0E9384"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,0,0,12">
                        <Border Padding="14" BackgroundColor="White" Stroke="#E3E7EF">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="📋" FontSize="23" TextColor="#512BD4" />
                                <Label Text="Órdenes de Compra" FontSize="12" TextColor="#111827" FontFamily="OpenSansSemibold" />
                                <Label x:Name="OciActivasLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="28" TextColor="#512BD4" />
                                <Label Text="Este mes" Style="{StaticResource SmallText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="14" BackgroundColor="White" Stroke="#E3E7EF">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="🏭" FontSize="23" TextColor="#2563EB" />
                                <Label Text="Órdenes de Trabajo" FontSize="12" TextColor="#111827" FontFamily="OpenSansSemibold" />
                                <Label x:Name="OtActivasLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="28" TextColor="#2563EB" />
                                <Label Text="Este mes" Style="{StaticResource SmallText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Padding="14" BackgroundColor="White" Stroke="#E3E7EF">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="🚚" FontSize="23" TextColor="#16A34A" />
                                <Label Text="Guías Internas" FontSize="12" TextColor="#111827" FontFamily="OpenSansSemibold" />
                                <Label x:Name="GuiasMesLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="28" TextColor="#16A34A" />
                                <Label Text="Este mes" Style="{StaticResource SmallText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="White" Stroke="#E3E7EF">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="🔔" FontSize="23" TextColor="#F97316" />
                                <Label Text="Alertas / Pendientes" FontSize="12" TextColor="#111827" FontFamily="OpenSansSemibold" />
                                <Label x:Name="StockAlertasLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="28" TextColor="#EF4444" />
                                <Label x:Name="StockResumenLabel" Text="Sin alertas" Style="{StaticResource SmallText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🛒  ÓRDENES DE COMPRA" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Text="Ver detalle ›" FontSize="12" TextColor="#512BD4" BackgroundColor="Transparent" Padding="0" Clicked="OnOciClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Pendiente" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OciPendientesLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#F59E0B" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Parcial" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OciParcialesLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#2563EB" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Despachadas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OciDespachadasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#16A34A" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="2">
                                    <Label Text="Entregadas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OciEntregadasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#059669" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <Label Text="Anuladas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OciAnuladasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#DC2626" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CardBorder}" Grid.Column="0">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="👥 Top 5 clientes con más OC" Style="{StaticResource SectionTitle}" FontSize="13" />
                                <CollectionView x:Name="TopClientesView" SelectionMode="None" MaximumHeightRequest="185">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="22,*,Auto" Padding="0,4" ColumnSpacing="5">
                                                <Label Text="{Binding Posicion}" FontSize="11" TextColor="#6B7280" />
                                                <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="11" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="2" Text="{Binding Cantidad}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#111827" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Últimos 6 meses (OC)" Style="{StaticResource SectionTitle}" FontSize="13" />
                                <CollectionView x:Name="ChartOciView" SelectionMode="None" MaximumHeightRequest="185">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="42,*,30" Padding="0,4" ColumnSpacing="6">
                                                <Label Text="{Binding Mes}" FontSize="10" TextColor="#6B7280" />
                                                <Grid Grid.Column="1" HeightRequest="9" VerticalOptions="Center">
                                                    <BoxView Color="#E5E7EB" CornerRadius="5" />
                                                    <BoxView WidthRequest="{Binding Ancho}" Color="#7C3AED" CornerRadius="5" HorizontalOptions="Start" />
                                                </Grid>
                                                <Label Grid.Column="2" Text="{Binding Total}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🏭  ÓRDENES DE TRABAJO" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Text="Ver detalle ›" FontSize="12" TextColor="#512BD4" BackgroundColor="Transparent" Padding="0" Clicked="OnOrdenesTrabajoClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="En proceso" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OtProcesoLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#2563EB" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Completadas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OtCompletadasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#16A34A" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Regularización" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OtRegularizacionLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#7C3AED" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="2">
                                    <Label Text="Abastecimiento" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OtAbastecimientoLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#F97316" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <Label Text="Anuladas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="OtAnuladasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#DC2626" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CardBorder}" Grid.Column="0">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Top 5 productos más elaborados" Style="{StaticResource SectionTitle}" FontSize="13" />
                                <CollectionView x:Name="TopProductosView" SelectionMode="None" MaximumHeightRequest="185">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="22,*,Auto" Padding="0,4" ColumnSpacing="5">
                                                <Label Text="{Binding Posicion}" FontSize="11" TextColor="#6B7280" />
                                                <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="11" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="2" Text="{Binding Cantidad}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#111827" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Últimos 6 meses (OT)" Style="{StaticResource SectionTitle}" FontSize="13" />
                                <CollectionView x:Name="ChartOtView" SelectionMode="None" MaximumHeightRequest="185">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="42,*,30" Padding="0,4" ColumnSpacing="6">
                                                <Label Text="{Binding Mes}" FontSize="10" TextColor="#6B7280" />
                                                <Grid Grid.Column="1" HeightRequest="9" VerticalOptions="Center">
                                                    <BoxView Color="#E5E7EB" CornerRadius="5" />
                                                    <BoxView WidthRequest="{Binding Ancho}" Color="#2563EB" CornerRadius="5" HorizontalOptions="Start" />
                                                </Grid>
                                                <Label Grid.Column="2" Text="{Binding Total}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🚚  GUÍAS INTERNAS DE SALIDA" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Text="Ver detalle ›" FontSize="12" TextColor="#16A34A" BackgroundColor="Transparent" Padding="0" Clicked="OnGuiaInternaClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Generadas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="GuiasGeneradasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#16A34A" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Pendientes" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="GuiasPendientesLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#F59E0B" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Atendidas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="GuiasAtendidasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#059669" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="2">
                                    <Label Text="Anuladas" FontSize="11" TextColor="#6B7280" />
                                    <Label x:Name="GuiasAnuladasLabel" Text="0" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#DC2626" />
                                </VerticalStackLayout>
                            </Grid>
                            <CollectionView x:Name="ChartGuiasView" SelectionMode="None" MaximumHeightRequest="160">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="42,*,30" Padding="0,4" ColumnSpacing="6">
                                            <Label Text="{Binding Mes}" FontSize="10" TextColor="#6B7280" />
                                            <Grid Grid.Column="1" HeightRequest="9" VerticalOptions="Center">
                                                <BoxView Color="#E5E7EB" CornerRadius="5" />
                                                <BoxView WidthRequest="{Binding Ancho}" Color="#16A34A" CornerRadius="5" HorizontalOptions="Start" />
                                            </Grid>
                                            <Label Grid.Column="2" Text="{Binding Total}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="🏆  PRODUCTIVIDAD DE USUARIOS" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Padding="12" BackgroundColor="#F8FAFC" Stroke="#E3E7EF">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Usuario con más OC" FontSize="11" TextColor="#6B7280" />
                                        <Label x:Name="UsuarioMasOcLabel" Text="-" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                        <Label x:Name="UsuarioMasOcCantidadLabel" Text="0 OC" FontSize="17" FontFamily="OpenSansSemibold" TextColor="#512BD4" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Padding="12" BackgroundColor="#F8FAFC" Stroke="#E3E7EF">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Usuario con más OT" FontSize="11" TextColor="#6B7280" />
                                        <Label x:Name="UsuarioMasOtLabel" Text="-" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                        <Label x:Name="UsuarioMasOtCantidadLabel" Text="0 OT" FontSize="17" FontFamily="OpenSansSemibold" TextColor="#2563EB" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Actividad reciente" Style="{StaticResource SectionTitle}" />
                                <Label Grid.Column="1" x:Name="LastUpdateLabel" FontSize="11" TextColor="#6B7280" />
                            </Grid>
                            <CollectionView x:Name="RecentActivityView" SelectionMode="None" MaximumHeightRequest="270">
                                <CollectionView.EmptyView>
                                    <Label Text="Sin actividad reciente." Padding="8" TextColor="#6B7280" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7" ColumnDefinitions="54,*" ColumnSpacing="8">
                                            <Label Text="{Binding Tipo}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{Binding Color}" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" TextColor="#111827" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Detalle}" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView x:Name="MenusView" IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid x:Name="MenuDrawerOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="#80000000"
              ColumnDefinitions="285,*">
            <Border Grid.Column="0"
                    BackgroundColor="#071F32"
                    StrokeThickness="0"
                    Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <VerticalStackLayout Padding="18,22,18,14" Spacing="8" BackgroundColor="#071F32">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="CorexProd" FontFamily="OpenSansSemibold" FontSize="21" TextColor="White" />
                                <Label x:Name="DrawerUserLabel" FontSize="12" TextColor="#BFD7EA" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="✕"
                                    FontSize="18"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    Clicked="OnCloseMenuClicked" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#21465F" Margin="0,8,0,0" />
                    </VerticalStackLayout>

                    <CollectionView Grid.Row="1"
                                    x:Name="ModuleMenuView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnModuleMenuSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,10" ColumnDefinitions="34,*" ColumnSpacing="10">
                                    <Label Text="{Binding Icono}" FontSize="19" TextColor="White" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="White" />
                                        <Label Text="{Binding Grupo}" FontSize="11" TextColor="#9EC6DD" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="2" Padding="18,12,18,20" Spacing="10">
                        <Button Text="Cerrar sesión"
                                FontSize="13"
                                FontFamily="OpenSansSemibold"
                                TextColor="White"
                                BackgroundColor="#EF4444"
                                CornerRadius="10"
                                Clicked="OnLogoutClicked" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    BackgroundColor="Transparent"
                    Clicked="OnCloseMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>