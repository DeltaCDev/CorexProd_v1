<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.HomePage"
             Title="Inicio"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8FC">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E2E6EF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="14" />
            </Setter>
            <Setter Property="Shadow">
                <Shadow Brush="#18000000" Offset="0,2" Radius="8" Opacity="0.16" />
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="#101828" />
        </Style>
        <Style x:Key="Small" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#667085" />
        </Style>
        <Style x:Key="NavText" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8FC">
        <!-- CABECERA -->
        <Grid Padding="18,22,18,16" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#592EDB" Offset="0" />
                    <GradientStop Color="#3020B7" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Button Text="☰" FontSize="31" TextColor="White" BackgroundColor="Transparent"
                    Padding="0" WidthRequest="44" HeightRequest="52" Clicked="OnToggleMenuClicked" />

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Panel principal" FontSize="22" FontFamily="OpenSansSemibold" TextColor="White" />
                <Label Text="Resumen operativo" FontSize="14" TextColor="#ECE9FF" />
            </VerticalStackLayout>

            <Grid Grid.Column="2" WidthRequest="48" HeightRequest="48">
                <Button Text="♧" FontSize="29" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="OnBellClicked" />
                <Border x:Name="AlertBadge" BackgroundColor="#EF3340" StrokeThickness="0" Padding="5,1"
                        HorizontalOptions="End" VerticalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Label x:Name="AlertCountLabel" Text="0" FontSize="10" FontFamily="OpenSansSemibold" TextColor="White" />
                </Border>
            </Grid>

            <Button Grid.Column="3" Text="◎" FontSize="34" TextColor="White" BackgroundColor="Transparent"
                    Padding="0" WidthRequest="44" Clicked="OnLogoutClicked" />
        </Grid>

        <!-- CONTENIDO -->
        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="14,12,14,22" Spacing="14">
                    <!-- PERIODO -->
                    <Border BackgroundColor="#F1EFFF" StrokeThickness="0" Padding="13,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#E3DEFF" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                                <Label Text="▣" FontSize="25" TextColor="#4B2BD4" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Período actual" FontSize="12" TextColor="#344054" />
                                <Label x:Name="PeriodoLabel" Text="Julio 2026" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#101828" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="⌄" FontSize="28" TextColor="#344054" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- KPI -->
                    <CollectionView x:Name="KpiView" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8" HeightRequest="148">
                                    <VerticalStackLayout Spacing="5" HorizontalOptions="Fill" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding SoftColor}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                                <Label Text="{Binding Icono}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{Binding Color}"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Valor}" FontSize="25" FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding Color}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Titulo}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#101828"
                                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                        <Label Text="{Binding Comparacion}" FontSize="9" TextColor="#667085" HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- SEGUIMIENTO -->
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Seguimiento de fechas de entrega" Style="{StaticResource SectionTitle}" />
                                    <Label Text="Órdenes próximas a vencer" Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Ver todas  ›" FontSize="12" TextColor="#4F2FD7"
                                        BackgroundColor="White" BorderColor="#BEB4FF" BorderWidth="1" CornerRadius="10"
                                        Padding="10,4" HeightRequest="38" Clicked="OnBellClicked" />
                            </Grid>

                            <CollectionView x:Name="EntregaResumenView" SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" BackgroundColor="{Binding Background}" StrokeThickness="0" HeightRequest="92">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Valor}" FontSize="21" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="10" TextColor="#101828" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                                <Label Text="{Binding Subtitulo}" FontSize="9" TextColor="#344054" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="Órdenes más urgentes" Style="{StaticResource Small}" Margin="2,2,0,0" />
                            <Border Stroke="#E4E7EC" StrokeThickness="1" Padding="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <CollectionView x:Name="UrgentesView" SelectionMode="None">
                                    <CollectionView.EmptyView>
                                        <Label Text="Sin OC vencidas o próximas." Padding="12" TextColor="#667085" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,9" ColumnDefinitions="18,*,Auto,28" ColumnSpacing="7">
                                                <Ellipse WidthRequest="11" HeightRequest="11" Fill="{Binding Brush}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="{Binding NumeroOci}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#101828" />
                                                    <Label Text="{Binding Cliente}" FontSize="10" TextColor="#475467" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="1" WidthRequest="125">
                                                    <Label Text="{Binding EstadoTexto}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" />
                                                    <Label Text="{Binding FechaEntregaTexto}" FontSize="10" TextColor="#344054" />
                                                    <Label Text="{Binding AlertaTexto}" FontSize="10" TextColor="{Binding Color}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="3" Text="›" FontSize="25" TextColor="#344054" BackgroundColor="Transparent" Padding="0" Clicked="OnVerAlertaClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RESUMEN OC / OT -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Órdenes de Compra" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#101828" />
                                    <Border Grid.Column="1" WidthRequest="38" HeightRequest="38" BackgroundColor="#EEEAFE" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Label Text="▣" TextColor="#4F2FD7" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#E4E7EC" />
                                <CollectionView x:Name="OcResumenView" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="2" VerticalItemSpacing="10" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Valor}" FontSize="19" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="9" TextColor="#475467" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <BoxView HeightRequest="1" Color="#E4E7EC" />
                                <Button Text="Ver todas las OC     ›" FontSize="11" TextColor="#4F2FD7" BackgroundColor="Transparent" Padding="0" Clicked="OnOciClicked" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Órdenes de Trabajo" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#101828" />
                                    <Border Grid.Column="1" WidthRequest="38" HeightRequest="38" BackgroundColor="#E9F8EF" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Label Text="▣" TextColor="#16A34A" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#E4E7EC" />
                                <CollectionView x:Name="OtResumenView" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="2" VerticalItemSpacing="10" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Valor}" FontSize="19" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Titulo}" FontSize="9" TextColor="#475467" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <BoxView HeightRequest="1" Color="#E4E7EC" />
                                <Button Text="Ver todas las OT     ›" FontSize="11" TextColor="#4F2FD7" BackgroundColor="Transparent" Padding="0" Clicked="OnOrdenesTrabajoClicked" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- TOP PRODUCTOS -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                                <Label Text="Top 5 productos más elaborados" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#101828" />
                                <Border Grid.Column="1" WidthRequest="38" HeightRequest="38" BackgroundColor="#EEEAFE" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="▥" FontSize="19" TextColor="#4F2FD7" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E4E7EC" />
                            <CollectionView x:Name="TopProductosView" SelectionMode="None" Margin="12,5,12,10">
                                <CollectionView.EmptyView>
                                    <Label Text="Sin productos elaborados este mes." Padding="10" TextColor="#667085" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                            <Border WidthRequest="23" HeightRequest="23" BackgroundColor="#EEF2FF" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Label Text="{Binding Posicion}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#4F2FD7" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="10" TextColor="#344054" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Cantidad}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#101828" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="ApiStatusLabel" Text="Conectando..." FontSize="10" TextColor="#667085" HorizontalTextAlignment="Center" />
                    <Label x:Name="LastUpdateLabel" FontSize="9" TextColor="#98A2B3" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- NAVEGACIÓN INFERIOR -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" BackgroundColor="White" Padding="5,7,5,9">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="1">
                <Label Text="⌂" FontSize="25" TextColor="#4F2FD7" HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Text="Inicio" Style="{StaticResource NavText}" TextColor="#4F2FD7" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="1">
                <Button Text="▣" FontSize="22" TextColor="#667085" BackgroundColor="Transparent" Padding="0" Clicked="OnOciClicked" />
                <Label Grid.Row="1" Text="OC" Style="{StaticResource NavText}" TextColor="#667085" />
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="1">
                <Button Text="+" FontSize="35" TextColor="White" BackgroundColor="#4F2FD7" CornerRadius="28" WidthRequest="56" HeightRequest="56" Padding="0" HorizontalOptions="Center" Clicked="OnNuevaOcClicked" />
                <Label Grid.Row="1" Text="Nueva OC" Style="{StaticResource NavText}" TextColor="#667085" />
            </Grid>
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="1">
                <Button Text="▣" FontSize="22" TextColor="#667085" BackgroundColor="Transparent" Padding="0" Clicked="OnOrdenesTrabajoClicked" />
                <Label Grid.Row="1" Text="OT" Style="{StaticResource NavText}" TextColor="#667085" />
            </Grid>
            <Grid Grid.Column="4" RowDefinitions="Auto,Auto" RowSpacing="1">
                <Button Text="•••" FontSize="20" TextColor="#667085" BackgroundColor="Transparent" Padding="0" Clicked="OnToggleMenuClicked" />
                <Label Grid.Row="1" Text="Más" Style="{StaticResource NavText}" TextColor="#667085" />
            </Grid>
        </Grid>

        <!-- ALERTAS -->
        <Grid x:Name="AlertOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#99000000" Padding="18,90,18,20">
            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14" VerticalOptions="Start">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Notificaciones de entrega" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="×" FontSize="22" BackgroundColor="Transparent" Clicked="OnCloseAlertsClicked" />
                    </Grid>
                    <CollectionView x:Name="AlertasView" SelectionMode="None" MaximumHeightRequest="520">
                        <CollectionView.EmptyView><Label Text="Sin alertas de entrega." Padding="12" TextColor="#667085" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,9" ColumnDefinitions="14,*,Auto" ColumnSpacing="9">
                                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding Brush}" VerticalOptions="Start" Margin="0,5,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding NumeroOci}" FontFamily="OpenSansSemibold" TextColor="#101828" />
                                        <Label Text="{Binding Cliente}" FontSize="12" TextColor="#344054" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding EstadoTexto}" FontSize="12" TextColor="#667085" />
                                        <Label Text="{Binding FechaEntregaTexto}" FontSize="12" TextColor="#667085" />
                                        <Label Text="{Binding AlertaTexto}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{Binding Color}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Ver" FontSize="12" Padding="8,3" BackgroundColor="#EEF2FF" TextColor="#4F2FD7" Clicked="OnVerAlertaClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MENÚ LATERAL -->
        <Grid x:Name="MenuDrawerOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#80000000" ColumnDefinitions="285,*">
            <Border BackgroundColor="#15103F" StrokeThickness="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <VerticalStackLayout Padding="18,22,18,14" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="CorexProd" FontFamily="OpenSansSemibold" FontSize="21" TextColor="White" />
                                <Label x:Name="DrawerUserLabel" FontSize="12" TextColor="#D3CCFF" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="×" FontSize="22" TextColor="White" BackgroundColor="Transparent" Clicked="OnCloseMenuClicked" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#3B3375" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                    <CollectionView Grid.Row="1" x:Name="ModuleMenuView" SelectionMode="Single" SelectionChanged="OnModuleMenuSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,10" ColumnDefinitions="34,*" ColumnSpacing="10">
                                    <Label Text="{Binding Icono}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="White" />
                                        <Label Text="{Binding Grupo}" FontSize="11" TextColor="#BBB1FF" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Row="2" Margin="18,12,18,20" Text="Cerrar sesión" TextColor="White" BackgroundColor="#EF4444" CornerRadius="10" Clicked="OnLogoutClicked" />
                </Grid>
            </Border>
            <Button Grid.Column="1" BackgroundColor="Transparent" Clicked="OnCloseMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>