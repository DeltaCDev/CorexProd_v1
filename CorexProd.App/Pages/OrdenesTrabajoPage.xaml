<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.OrdenesTrabajoPage"
             Title="OT Producción">
    <Grid RowDefinitions="Auto,*" BackgroundColor="#F4F6F8">
        <VerticalStackLayout Padding="14" Spacing="10" BackgroundColor="White">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Spacing="3"><Label Text="Desde" FontSize="11" TextColor="#667085"/><DatePicker x:Name="FechaDesde" DateSelected="OnFilterChanged"/></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Hasta" FontSize="11" TextColor="#667085"/><DatePicker x:Name="FechaHasta" DateSelected="OnFilterChanged"/></VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker x:Name="EstadoPicker" Title="Estado" SelectedIndexChanged="OnFilterChanged"/>
                <Entry Grid.Column="1" x:Name="ClienteFilter" Placeholder="Cliente" TextChanged="OnFilterTextChanged"/>
            </Grid>
            <SearchBar x:Name="Search"
                       Placeholder="OT, OCI, cliente o estado"
                       SearchButtonPressed="OnSearchPressed"
                       TextChanged="OnSearchTextChanged" />
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="CountLabel"
                       Text="Sin datos"
                       TextColor="#637083"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Buscar"
                        Clicked="OnBuscarClicked" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="OrdenesView"
                            Margin="12"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay órdenes de trabajo para mostrar."
                           Padding="24"
                           HorizontalTextAlignment="Center"
                           TextColor="#637083" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" BackgroundColor="White" Stroke="#D9E0E6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                    <Button Text="Ver"
                                            Padding="10,6"
                                            BackgroundColor="#0E9384"
                                            Clicked="OnVerClicked" />
                                    <Button Grid.Column="1"
                                            Text="X"
                                            Padding="10,6"
                                            BackgroundColor="#B42318"
                                            IsVisible="{Binding PuedeAnular}"
                                            Clicked="OnAnularClicked" />
                                    <Button Grid.Column="2"
                                            Text="!"
                                            IsVisible="{Binding MostrarAnulacion}"
                                            Padding="10,6"
                                            BackgroundColor="#F04438"
                                            Clicked="OnAnulacionInfoClicked" />
                                    <Button Grid.Column="3"
                                            Text="Regularizar"
                                            IsVisible="{Binding PuedeRegularizar}"
                                            Padding="10,6"
                                            BackgroundColor="#7A5AF8"
                                            Clicked="OnRegularizarClicked" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="128,*" RowSpacing="5" ColumnSpacing="8">
                                    <Label Text="Numero de OT" FontSize="12" TextColor="#667085" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding NumeroOT}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#10324A" VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                Padding="9,3"
                                                BackgroundColor="{Binding EstadoBackgroundColor}"
                                                Stroke="{Binding EstadoStrokeColor}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Estado}"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding EstadoTextColor}" />
                                        </Border>
                                    </Grid>
                                    <Label Grid.Row="1" Text="Fecha y Hora" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding FechaHoraTexto}" TextColor="#344054" />
                                    <Label Grid.Row="2" Text="OC Cliente" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding OrdenCompraClienteTexto}" TextColor="#344054" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="3" Text="Cliente" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Cliente}" TextColor="#344054" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="4" Text="Nro OCI" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding NumeroOciTexto}" TextColor="#344054" />
                                    <Label Grid.Row="5" Text="Tipo OT" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding TipoOT}" TextColor="#344054" />
                                    <Label Grid.Row="6" Text="OT relacionada" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="6" Grid.Column="1" Text="{Binding OtRelacionadaTexto}" TextColor="#344054" />
                                    <Label Grid.Row="7" Text="Usuario" FontSize="12" TextColor="#667085" />
                                    <Label Grid.Row="7" Grid.Column="1" Text="{Binding Usuario}" TextColor="#344054" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
