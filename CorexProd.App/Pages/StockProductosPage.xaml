<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.StockProductosPage"
             Title="Disponibilidad productos">
    <Grid RowDefinitions="Auto,*" BackgroundColor="#F4F6F8">
        <VerticalStackLayout Padding="14" Spacing="10" BackgroundColor="White">
            <SearchBar x:Name="Search"
                       Placeholder="Codigo, producto o almacen"
                       SearchButtonPressed="OnSearchPressed"
                       TextChanged="OnSearchTextChanged" />
            <SearchBar x:Name="EtiquetaSearch"
                       Placeholder="Etiqueta / Cliente"
                       SearchButtonPressed="OnSearchPressed"
                       TextChanged="OnSearchTextChanged" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="CountLabel"
                       Text="Sin datos"
                       TextColor="#637083"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Exportar"
                        Clicked="OnExportarClicked" />
                <Button Grid.Column="2"
                        Text="Buscar"
                        Clicked="OnBuscarClicked" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     x:Name="Refresh"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="ItemsView"
                            Margin="12"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="No hay disponibilidad para mostrar."
                               HorizontalTextAlignment="Center"
                               TextColor="#637083" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" BackgroundColor="White" Stroke="#D9E0E6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="4">
                                <Label Text="{Binding Codigo}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       TextColor="#10324A" />
                                <Label Grid.Column="1"
                                       Text="{Binding StockDisponible, StringFormat='{0:N3}'}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="#067647" />
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Producto}"
                                       LineBreakMode="WordWrap"
                                       TextColor="#344054" />
                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding EtiquetaCliente}"
                                       FontSize="12"
                                       TextColor="#0F766E" />
                                <Label Grid.Row="3"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding NombreAlmacen}"
                                       FontSize="12"
                                       TextColor="#667085" />
                                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Fisico" FontSize="11" TextColor="#667085" />
                                        <Label Text="{Binding StockFisico, StringFormat='{0:N3}'}" FontFamily="OpenSansSemibold" TextColor="#344054" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="Reservado" FontSize="11" TextColor="#667085" />
                                        <Label Text="{Binding StockReservado, StringFormat='{0:N3}'}" FontFamily="OpenSansSemibold" TextColor="#B54708" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="0">
                                        <Label Text="Disponible" FontSize="11" TextColor="#667085" />
                                        <Label Text="{Binding StockDisponible, StringFormat='{0:N3}'}" FontFamily="OpenSansSemibold" TextColor="#067647" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        Text="Historial de reservas"
                                        Margin="0,8,0,0"
                                        BackgroundColor="#EAF2FF"
                                        TextColor="#155EEF"
                                        Clicked="OnHistorialClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
