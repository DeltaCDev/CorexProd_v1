<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.SeguridadPage"
             Title="Seguridad">
    <Grid BackgroundColor="#F4F6F8" RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,14,16,8" Spacing="10" BackgroundColor="White">
            <Label Text="Seguridad y configuración" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#10324A" />
            <Picker x:Name="ModuloPicker" Title="Seleccione un módulo" SelectedIndexChanged="OnModuloChanged" />
            <SearchBar x:Name="BuscarEntry" Placeholder="Buscar" TextChanged="OnBuscarChanged" />
            <Button Text="Nuevo registro" Clicked="OnNuevoClicked" BackgroundColor="#4F2ACD" />
            <Button Text="Administrar permisos del rol" Clicked="OnPermisosClicked" BackgroundColor="#0F766E" IsVisible="False" x:Name="PermisosButton" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" x:Name="Refrescar" Refreshing="OnRefresh">
            <CollectionView x:Name="Lista" EmptyView="No hay registros para mostrar." SelectionMode="None" Margin="12,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#D9E0E6" Padding="14" Margin="0,0,0,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Titulo}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#10324A" />
                                <Label Text="{Binding Detalle}" FontSize="13" TextColor="#475467" />
                                <Label Text="{Binding Estado}" FontSize="12" TextColor="#0F766E" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator Grid.Row="1" x:Name="Cargando" IsVisible="False" IsRunning="False" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
