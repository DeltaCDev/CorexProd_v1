<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorexProd.App.Pages.OrdenTrabajoManualPage"
             Title="OT Manual">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F4F6F8">
        <VerticalStackLayout Padding="14" Spacing="10" BackgroundColor="White">
            <Label Text="Crear OT Manual"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   TextColor="#10324A" />
            <Picker x:Name="MotivoPicker"
                    Title="Motivo"
                    SelectedIndexChanged="OnMotivoChanged" />
            <SearchBar x:Name="BuscarProducto"
                       Placeholder="Buscar producto por codigo, nombre o etiqueta"
                       SearchButtonPressed="OnBuscarProducto"
                       TextChanged="OnBuscarProductoChanged" />
            <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="8">
                <Picker x:Name="ProductoPicker"
                        Title="Producto"
                        ItemDisplayBinding="{Binding Display}" />
                <Entry Grid.Column="1"
                       x:Name="CantidadEntry"
                       Placeholder="Cant."
                       Keyboard="Numeric" />
                <Button Grid.Column="2"
                        Text="Agregar"
                        Clicked="OnAgregarClicked" />
            </Grid>
            <Editor x:Name="ObservacionEditor"
                    Placeholder="Observacion"
                    AutoSize="TextChanges"
                    HeightRequest="70" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="DetallesView"
                            Margin="12"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Agregue productos para generar la OT manual."
                           Padding="24"
                           HorizontalTextAlignment="Center"
                           TextColor="#637083" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" BackgroundColor="White" Stroke="#D9E0E6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding ProductoTexto}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#10324A"
                                       LineBreakMode="WordWrap" />
                                <Button Grid.Column="1"
                                        Text="Quitar"
                                        Padding="10,6"
                                        BackgroundColor="#B42318"
                                        Clicked="OnQuitarClicked" />
                                <Label Grid.Row="1"
                                       Text="{Binding CantidadTexto}"
                                       TextColor="#344054" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" Padding="14" Spacing="8" BackgroundColor="White">
            <Label x:Name="ResumenLabel"
                   Text="0 productos"
                   TextColor="#667085" />
            <Button x:Name="GuardarButton"
                    Text="Validar y generar OT"
                    BackgroundColor="#0E9384"
                    Clicked="OnGuardarClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
