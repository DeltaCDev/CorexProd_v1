<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CorexProd.App.Controls.SidebarMenuView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#061F33">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#061F33">
        <!-- CABECERA -->
        <VerticalStackLayout Padding="22,24,20,14" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="#5B32DB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="C" FontSize="27" FontFamily="OpenSansSemibold" TextColor="White"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>

                <Label Grid.Column="1" Text="CorexProd" FontSize="24" FontFamily="OpenSansSemibold"
                       TextColor="White" VerticalTextAlignment="Center" />

                <Button Grid.Column="2" Text="×" FontSize="34" TextColor="White"
                        BackgroundColor="Transparent" Padding="0" WidthRequest="44" HeightRequest="50"
                        Clicked="OnCloseClicked" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border WidthRequest="54" HeightRequest="54" Stroke="#BFAFFF" StrokeThickness="1"
                        BackgroundColor="#7A5BE7">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27" />
                    </Border.StrokeShape>
                    <Label Text="●" FontSize="31" TextColor="White"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="UserNameLabel" Text="Usuario" FontSize="16"
                           FontFamily="OpenSansSemibold" TextColor="White" LineBreakMode="TailTruncation" />
                    <Label x:Name="UserRoleLabel" Text="Administrador" FontSize="13"
                           TextColor="#A9C8E3" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="#24445C" Margin="0,5,0,0" />
        </VerticalStackLayout>

        <!-- MENÚ SINCRONIZADO CON EL CATÁLOGO DE SEGURIDAD -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="MenuContainer" Padding="16,2,16,18" Spacing="8" />
        </ScrollView>

        <!-- CERRAR SESIÓN -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,18" Spacing="10">
            <BoxView HeightRequest="1" Color="#24445C" />
            <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="48" Padding="12,4">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLogoutTapped" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                    <Image Source="logout_icon.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                    <Label Grid.Column="1" Text="Cerrar sesión" FontSize="15" FontFamily="OpenSansSemibold"
                           TextColor="#0B3B92" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>
