<Window x:Class="CorexProd.WPF.Modules.Seguridad.Views.FirmaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de firma"
        Width="620"
        Height="420"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
            <Image x:Name="FirmaImage" Stretch="Uniform"/>
        </Border>
        <Button Grid.Row="1" Content="Cerrar" Width="100" Height="34" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/>
    </Grid>
</Window>
