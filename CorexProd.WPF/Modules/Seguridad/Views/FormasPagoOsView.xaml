<UserControl x:Class="CorexProd.WPF.Modules.Seguridad.Views.FormasPagoOsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CeldaTexto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Formas de pago OS" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Administra las formas disponibles para pagos de ordenes de servicio" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource CampoTexto}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Content="Activo" IsChecked="{Binding Estado}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,14,8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" Margin="0,0,8,0"/>
                    <Button Content="Nuevo" Style="{StaticResource BotonBase}" Command="{Binding NuevoCommand}" Margin="0,0,8,0"/>
                    <Button Content="Desactivar" Style="{StaticResource BotonBase}" Command="{Binding EliminarCommand}" Margin="0,0,8,0"/>
                    <Button Content="Actualizar" Style="{StaticResource BotonBase}" Command="{Binding RefrescarCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResumenRegistros}" FontWeight="SemiBold" Foreground="#475569" Margin="14,10"/>
                <DataGrid ItemsSource="{Binding Formas}" SelectedItem="{Binding FormaSeleccionada}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="42" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource CeldaTexto}"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="140" ElementStyle="{StaticResource CeldaTexto}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
