<Window x:Class="CorexProd.WPF.Modules.Ventas.Views.OrdenCompraInternaDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de OCI"
        Width="1440"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#F6F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#1E293B"
                          Opacity="0.08"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6D5BB7"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4C1D95"/>
            <Setter Property="BorderBrush" Value="#5B21B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EDE9FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4C1D95"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C1D95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3B0764"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,18,26,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource BackButton}" Click="Cerrar_Click" ToolTip="Volver">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#111827"/>
            </Button>
            <TextBlock Text="Detalle de OCI"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#111827"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Cabecera de la orden -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="18,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OC Cliente" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding OrdenCompraCliente}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="16" Padding="14,6" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="PROCESO"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="BorderBrush" Value="#60A5FA"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="En proceso"><Setter Property="Background" Value="#FEF3C7"/><Setter Property="BorderBrush" Value="#F59E0B"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Parcial"><Setter Property="Background" Value="#FFEDD5"/><Setter Property="BorderBrush" Value="#FB923C"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Entregado"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="BorderBrush" Value="#4ADE80"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Anulado"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="BorderBrush" Value="#F87171"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="En proceso"><Setter Property="Foreground" Value="#92400E"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Parcial"><Setter Property="Foreground" Value="#C2410C"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Entregado"><Setter Property="Foreground" Value="#166534"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Anulado"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#E5E7EB" Margin="0,12,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NombreCliente}" Style="{StaticResource FieldValue}" ToolTip="{Binding NombreCliente}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="22,0">
                        <TextBlock Text="Fecha Emisión" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FechaEmision, StringFormat=dd/MM/yyyy}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="22,0">
                        <TextBlock Text="Fecha Entrega" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FechaEntrega, StringFormat=dd/MM/yyyy}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="22,0,0,0">
                        <TextBlock Text="OC Interna" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NumeroOci}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.55*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Productos -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Detalles.Count, StringFormat=Productos ({0})}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Detalles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="13"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="#F3F0FF" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CodigoProducto}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#5B21B6"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NombreProducto}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#172033"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding NombreProducto}"
                                                           VerticalAlignment="Center"
                                                           Margin="14,0"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CantidadVisualTexto}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4C1D95"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Grid.Row="1" Height="1" Background="#EEF2F7" Margin="0,10,0,10"/>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.9*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Disponibilidad"
                                                               FontSize="11"
                                                               Foreground="#6D5BB7"
                                                               Margin="0,0,0,5"/>

                                                    <ProgressBar Minimum="0"
                                                                 Maximum="{Binding Cantidad}"
                                                                 Value="{Binding StockActual}"
                                                                 Height="7"
                                                                 Foreground="#22C55E"
                                                                 Background="#D1D5DB"
                                                                 BorderThickness="0"/>

                                                    <TextBlock Text="{Binding DisponibilidadTexto}"
                                                               FontSize="10.5"
                                                               Foreground="#64748B"
                                                               Margin="0,5,0,7"/>

                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,5">
                                                            <TextBlock Text="●" Foreground="#16A34A" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding StockDisponibleTexto}" Foreground="#159A61" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CantidadFaltanteParaEnviar}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="●" Foreground="#F43F5E" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding FaltanteVisualTexto}" Foreground="#E54866" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,1,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding StockProcesoReservadoTooltip}">
                                                            <TextBlock Text="En proceso reservado: " Foreground="#64748B" FontSize="9.8"/>
                                                            <TextBlock Text="{Binding StockProcesoReservado, StringFormat={}{0:N2} Und}" Foreground="#475569" FontSize="9.8" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Despachado: " Foreground="#64748B" FontSize="9.8"/>
                                                            <TextBlock Text="{Binding CantidadDespachada, StringFormat={}{0:N2} Und}" Foreground="#475569" FontSize="9.8" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="11,9">
                                                    <StackPanel>
                                                        <TextBlock Text="Observación"
                                                                   FontSize="11"
                                                                   Foreground="#6D5BB7"
                                                                   Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding ObservacionVisual}"
                                                                   FontSize="10.5"
                                                                   Foreground="#64748B"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Panel derecho -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Observación General" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,10"/>
                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7" Padding="12">
                            <TextBlock Text="Sin observaciones generales."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Resumen" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,11">
                            <TextBlock Text="Subtotal" Foreground="#64748B" FontSize="11.5"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5">
                                <Run Text="S/ "/><Run Text="{Binding Subtotal, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,11">
                            <TextBlock Foreground="#64748B" FontSize="11.5">
                                <Run Text="IGV ("/><Run Text="{Binding IgvPorcentaje, StringFormat={}{0:N0}}"/><Run Text="%)"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5">
                                <Run Text="S/ "/><Run Text="{Binding Igv, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock Text="Descuento" Foreground="#64748B" FontSize="11.5"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5">
                                <Run Text="S/ "/><Run Text="{Binding Descuento, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="5"
                                Background="#F4F0FF"
                                BorderBrush="#D8CCFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,12">
                            <Grid>
                                <TextBlock Text="TOTAL"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#4C1D95"
                                           VerticalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Foreground="#3F168C"
                                           VerticalAlignment="Center">
                                    <Run Text="S/ "/><Run Text="{Binding Total, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <Button Style="{StaticResource ActionButton}" Click="DescargarPdf_Click" Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Descargar PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}" Click="Compartir_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Compartir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Button Grid.Row="3"
                Content="Cerrar"
                Style="{StaticResource CloseButton}"
                HorizontalAlignment="Center"
                Margin="0,14,0,0"
                Click="Cerrar_Click"/>
    </Grid>
</Window>
