<Window x:Class="CorexProd.WPF.Modules.Ventas.Views.OrdenCompraInternaDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle Orden de Compra"
        Width="1440" Height="820" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="#F6F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#1E293B" Opacity="0.08"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6D5BB7"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5B21B6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Texto" Property="Foreground" Value="#3B0764"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#4C1D95"/>
            <Setter Property="BorderBrush" Value="#5B21B6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#F5F3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4C1D95"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4C1D95"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="130"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,18,26,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Width="38" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Cerrar_Click" ToolTip="Volver">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#4C1D95"/>
            </Button>
            <TextBlock Text="Detalle Orden de Compra" FontSize="23" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="286"/><ColumnDefinition Width="14"/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OC Cliente" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding OrdenCompraCliente}" FontSize="28" FontWeight="SemiBold" Foreground="#4C1D95"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="Tiempo transcurrido" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                            <TextBlock x:Name="FechaEmisionHoraText" FontSize="11" Foreground="#334155" Margin="0,3,0,0"/>
                            <TextBlock x:Name="FechaCierreText" FontSize="11" Foreground="#334155"/>
                            <TextBlock x:Name="TiempoTranscurridoText" FontSize="15" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FechaEntregaPanel" Grid.Column="3" Background="#FFF1F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="Fecha de entrega" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="FechaEntregaCabeceraText" FontSize="17" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,0"/>
                            <TextBlock x:Name="FechaEntregaEstadoText" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="#E5E7EB" Margin="0,12"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0"><TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NombreCliente}" Style="{StaticResource FieldValue}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0"><TextBlock Text="Fecha Emisión" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding FechaEmisionVisual}" Style="{StaticResource FieldValue}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="22,0"><TextBlock Text="Fecha Entrega" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding FechaEntregaVisual}" Style="{StaticResource FieldValue}"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="22,0"><TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding UsuarioGenerador}" Style="{StaticResource FieldValue}"/></StackPanel>
                    <StackPanel Grid.Column="4" Margin="22,0,0,0"><TextBlock Text="OC Interna" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NumeroOci}" Style="{StaticResource FieldValue}"/></StackPanel>
                </Grid>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16" Padding="14,6" Background="#DBEAFE" BorderBrush="#60A5FA" BorderThickness="1" Margin="0,0,0,0">
                    <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding CantidadProductosTexto}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Detalles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="#F3F0FF" CornerRadius="10" Padding="9,4"><TextBlock Text="{Binding CodigoProducto}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#5B21B6"/></Border>
                                                <TextBlock Grid.Column="1" Text="{Binding NombreProducto}" FontSize="13" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis" Margin="14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CantidadVisualTexto}" FontSize="14" FontWeight="SemiBold" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Border Grid.Row="1" Height="1" Background="#EEF2F7" Margin="0,10"/>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding DisponibilidadTexto}" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                                                    <WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,7"><TextBlock Text="●" Foreground="#16A34A" Margin="0,0,6,0"/><TextBlock Text="{Binding StockDisponibleTexto}" Foreground="#159A61" FontSize="11"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><TextBlock Text="●" Foreground="#F43F5E" Margin="0,0,6,0"/><TextBlock Text="{Binding FaltanteVisualTexto}" Foreground="#E54866" FontSize="11"/></StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel>
                                                        <TextBlock Text="En proceso reservado: " Foreground="#64748B" FontSize="10.5"/><TextBlock Text="{Binding StockProcesoVisualTexto}" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                        <TextBlock Text="Despachado: " Foreground="#64748B" FontSize="10.5"/><TextBlock Text="{Binding CantidadDespachadaVisualTexto}" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7" Padding="11,9">
                                                    <StackPanel><TextBlock Text="Observación" FontSize="11" Foreground="#6D5BB7" Margin="0,0,0,5"/><TextBlock Text="{Binding ObservacionVisual}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="7" Background="#5B21B6"><StackPanel VerticalAlignment="Center"><TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="OT" Foreground="White" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Órdenes de Trabajo asociadas" FontSize="17" FontWeight="SemiBold" Foreground="#4C1D95"/><TextBlock x:Name="ResumenOtText" Text="Sin OT relacionadas" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel></Grid>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Background="#FAFAFF" Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".85*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions><TextBlock Text="Orden de Trabajo" FontSize="10" Foreground="#5B21B6" FontWeight="SemiBold" Margin="10,8"/><TextBlock Grid.Column="1" Text="Estado" FontSize="10" Foreground="#5B21B6" FontWeight="SemiBold" Margin="8"/><TextBlock Grid.Column="2" Text="Unidades" FontSize="10" Foreground="#5B21B6" FontWeight="SemiBold" Margin="8"/><TextBlock Grid.Column="3" Text="Área / Progreso" FontSize="10" Foreground="#5B21B6" FontWeight="SemiBold" Margin="8"/><TextBlock Grid.Column="4" Text="Acción" FontSize="10" Foreground="#5B21B6" FontWeight="SemiBold" Margin="8"/></Grid>
                                <ItemsControl x:Name="OrdenesTrabajoItems" Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".85*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
                                                    <Button Content="{Binding NumeroOT}" Tag="{Binding IdOrdenTrabajo}" Style="{StaticResource LinkButton}" Margin="10,10" Click="AbrirOrdenTrabajo_Click" ToolTip="Ver detalle de la Orden de Trabajo"/>
                                                    <Border Grid.Column="1" Background="{Binding EstadoFondo}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoColor}" FontSize="9.5" FontWeight="SemiBold"/></Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding UnidadesTexto}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding AreaTexto}" FontSize="10.5" VerticalAlignment="Center" Margin="8" TextTrimming="CharacterEllipsis" ToolTip="{Binding AreaTexto}"/>
                                                    <Button Grid.Column="4" Content="Ver detalle" Tag="{Binding IdOrdenTrabajo}" Style="{StaticResource LinkButton}" Margin="8" Click="AbrirOrdenTrabajo_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Resumen OC" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8"><TextBlock Text="Subtotal" Foreground="#64748B" FontSize="11.5"/><TextBlock Text="{Binding SubtotalVisual}" HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5"/></Grid>
                        <Grid Margin="0,0,0,8"><TextBlock Text="{Binding IgvEtiqueta}" Foreground="#64748B" FontSize="11.5"/><TextBlock Text="{Binding IgvVisual}" HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5"/></Grid>
                        <Grid Margin="0,0,0,10"><TextBlock Text="Descuento" Foreground="#64748B" FontSize="11.5"/><TextBlock Text="{Binding DescuentoVisual}" HorizontalAlignment="Right" Foreground="#334155" FontSize="11.5"/></Grid>
                        <Border Background="#F4F0FF" BorderBrush="#D8CCFF" BorderThickness="1" CornerRadius="8" Padding="13,10"><Grid><TextBlock Text="Total" FontSize="14" FontWeight="SemiBold" Foreground="#4C1D95"/><TextBlock Text="{Binding TotalVisual}" HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold" Foreground="#3F168C"/></Grid></Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Observación General" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7" Padding="12" MinHeight="55"><TextBlock Text="Sin observaciones generales." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/></Border>
                        <Button Grid.Row="2" Style="{StaticResource ActionButton}" Click="DescargarPdf_Click" Margin="0,10,0,9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="Descargar PDF"/></StackPanel></Button>
                        <Button Grid.Row="3" Style="{StaticResource PrimaryActionButton}" Click="Compartir_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="Compartir"/></StackPanel></Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource CloseButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Cerrar_Click"/>
    </Grid>
</Window>