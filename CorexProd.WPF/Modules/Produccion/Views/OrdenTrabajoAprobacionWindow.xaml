<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.OrdenTrabajoAprobacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aprobación de Orden de Trabajo" Height="650" Width="1050"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#124A91" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="VISUALIZAR Y APROBAR ORDEN DE TRABAJO" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="CabeceraText" Foreground="#DBEAFE" Margin="0,5,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cliente" Foreground="#64748B"/><TextBlock x:Name="ClienteText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="OC Cliente" Foreground="#64748B"/><TextBlock x:Name="OcText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fecha emisión" Foreground="#64748B"/><TextBlock x:Name="FechaText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Estado aprobación" Foreground="#64748B"/><TextBlock x:Name="EstadoText" FontWeight="Bold" Foreground="#B45309"/></StackPanel></Grid></Border>
        <DataGrid Grid.Row="2" x:Name="DetalleGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12"><DataGrid.Columns><DataGridTextColumn Header="Modelo / Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/><DataGridTextColumn Header="Req. OC" Binding="{Binding Requerida, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Stock actual" Binding="{Binding StockActual, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Faltante" Binding="{Binding Faltante, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Adicional stock" Binding="{Binding Adicional, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Total a producir" Binding="{Binding Total, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Rechazar" Width="120" Height="38" Margin="0,0,10,0" Background="#DC2626" Foreground="White" Click="Rechazar_Click"/><Button Content="Aprobar OT" Width="130" Height="38" Margin="0,0,10,0" Background="#16A34A" Foreground="White" Click="Aprobar_Click"/><Button Content="Cerrar" Width="100" Height="38" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
