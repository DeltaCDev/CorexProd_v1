<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.OrdenTrabajoDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Orden de Trabajo"
        Height="720"
        Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="NumeroText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClienteText" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock x:Name="OciText"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="OrdenCompraText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EstadoText" Margin="0,9,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Border x:Name="TiempoProduccionBorder"
                        Grid.Column="3"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Loaded="TiempoProduccionPanel_Loaded">
                    <StackPanel>
                        <TextBlock x:Name="TiempoProduccionTituloText"
                                   Text="Tiempo de producción"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock x:Name="FechaEmisionProduccionText"
                                   Margin="0,3,0,0"
                                   FontSize="10.5"
                                   Foreground="#334155"/>
                        <TextBlock x:Name="FechaTerminoProduccionText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#334155"/>
                        <TextBlock x:Name="TiempoProduccionText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FechaEntregaBorder"
                        Grid.Column="4"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Loaded="FechaEntregaPanel_Loaded">
                    <StackPanel>
                        <TextBlock Text="Fecha de entrega"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="FechaEntregaText"
                                   Margin="0,3,0,0"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="FechaEntregaAlertaText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Productos y Detalles de Produccion">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Productos y Detalles de Produccion" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="P: Pendiente | E: Enviado | R: Reservado | M: Merma" Foreground="#64748B" Margin="0,4,0,10"/>
                    </StackPanel>
                    <DataGrid x:Name="ResumenGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FrozenColumnCount="3"
                              MinRowHeight="78"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="Operaciones por area" Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Area:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="AreaCombo" Width="210" DisplayMemberPath="NombreArea" SelectionChanged="AreaCombo_SelectionChanged"/>
                        <Button Content="Iniciar seleccionados" Margin="8,0,0,0" Padding="12,5" Click="Iniciar_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Seleccionado}" Width="48"/>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoProducto}" IsReadOnly="True" Width="40"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Recibido" Binding="{Binding CantidadRecibida,StringFormat=N2}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Enviado" Binding="{Binding CantidadEnviada,StringFormat=N2}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Reservado" Binding="{Binding CantidadReservada,StringFormat=N2}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Merma" Binding="{Binding CantidadMerma,StringFormat=N2}" IsReadOnly="True" Width="75"/>
                            <DataGridTextColumn Header="Pendiente" Binding="{Binding CantidadPendienteDisponible,StringFormat=N2}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadOperacion,UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Modo" Binding="{Binding ModoEnvio}" IsReadOnly="True" Width="75"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Enviar todos" Padding="12,6" Click="EnviarTodos_Click"/>
                        <Button Content="Transferir" Margin="7,0,0,0" Padding="12,6" Click="Transferir_Click"/>
                        <Button Content="Registrar merma" Margin="7,0,0,0" Padding="12,6" Click="Merma_Click"/>
                        <Button Content="Confirmar consumo" Margin="7,0,0,0" Padding="12,6" Click="Consumo_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Cerrar" Width="90" Height="34" HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>
    </Grid>
</Window>