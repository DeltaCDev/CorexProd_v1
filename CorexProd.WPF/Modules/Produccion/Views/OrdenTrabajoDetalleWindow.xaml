<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.OrdenTrabajoDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Orden de Trabajo"
        Height="720"
        Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="NumeroText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClienteText" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock x:Name="OciText"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="OrdenCompraText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EstadoText" Margin="0,9,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Border x:Name="TiempoProduccionBorder"
                        Grid.Column="3"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Loaded="TiempoProduccionPanel_Loaded">
                    <StackPanel>
                        <TextBlock x:Name="TiempoProduccionTituloText"
                                   Text="Tiempo de producción"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock x:Name="FechaEmisionProduccionText"
                                   Margin="0,3,0,0"
                                   FontSize="10.5"
                                   Foreground="#334155"/>
                        <TextBlock x:Name="FechaTerminoProduccionText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#334155"/>
                        <TextBlock x:Name="TiempoProduccionText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FechaEntregaBorder"
                        Grid.Column="4"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Loaded="FechaEntregaPanel_Loaded">
                    <StackPanel>
                        <TextBlock Text="Fecha de entrega"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="FechaEntregaText"
                                   Margin="0,3,0,0"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="FechaEntregaAlertaText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Productos y Detalles de Produccion">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Productos y Detalles de Produccion"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ObservacionGeneralButton"
                                    Content="Obs. general"
                                    Padding="10,4"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="ObservacionGeneral_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="P: Pendiente | E: Enviado | R: Reservado | M: Merma" Foreground="#64748B" Margin="0,4,0,10"/>
                    </StackPanel>
                    <DataGrid x:Name="ResumenGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FrozenColumnCount="3"
                              MinRowHeight="78"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="Servicios externos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Servicios externos" FontSize="17" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="Seleccione los productos pendientes, indique la cantidad y envíelos al proveedor externo." Margin="0,4,0,0" Foreground="#475569"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="AreaCombo" Visibility="Collapsed" DisplayMemberPath="NombreArea" SelectionChanged="AreaCombo_SelectionChanged"/>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="False" HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Seleccionado,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding NombreArea}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoProducto}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Pendiente" Binding="{Binding CantidadPendienteDisponible,StringFormat=N2}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="En servicio" Binding="{Binding CantidadEnServicioExterno,StringFormat=N2}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Disponible" Binding="{Binding CantidadDisponibleParaOperacion,StringFormat=N2}" IsReadOnly="True" Width="105"/>
                            <DataGridTemplateColumn Header="Cantidad a enviar" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CantidadOperacion,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="90" Height="30" Padding="7,2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Seleccionar todos" Padding="12,7" Click="SeleccionarTodosServicio_Click"/>
                        <Button Content="Quitar selección" Margin="8,0,0,0" Padding="12,7" Click="QuitarSeleccionServicio_Click"/>
                        <Button Content="Enviar a servicio externo" Padding="14,7" Click="EnviarServicioExterno_Click"/>
                        <Button Content="Registrar retornos seleccionados" Margin="8,0,0,0" Padding="14,7" Click="RetornarServicioExterno_Click"/>
                        <Button Content="Ver historial de servicios" Margin="8,0,0,0" Padding="14,7" Click="VerServicioExterno_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Cerrar" Width="90" Height="34" HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>
    </Grid>
</Window>
