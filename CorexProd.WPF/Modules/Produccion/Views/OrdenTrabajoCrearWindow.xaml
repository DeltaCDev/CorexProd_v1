<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.OrdenTrabajoCrearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar orden de trabajo" Height="760" Width="1450" MinHeight="620" MinWidth="1120"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F4F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="Azul" Color="#124A91"/>
        <Style x:Key="Campo" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#A9B9D4"/><Setter Property="Background" Value="White"/><Setter Property="IsReadOnly" Value="True"/></Style>
        <DataTemplate x:Key="EncabezadoTabla"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
        <Style x:Key="Etiqueta" TargetType="TextBlock"><Setter Property="Foreground" Value="#172554"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="Ficha" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#1261B0"/><Setter Property="Background" Value="#F8FBFF"/><Setter Property="BorderBrush" Value="#7DB4F5"/><Setter Property="FontSize" Value="17"/></Style>
        <Style x:Key="NumeroDerecha" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,8,0"/></Style>
        <Style x:Key="Deficit" TargetType="TextBlock"><Setter Property="Text" Value="{Binding Deficit, StringFormat=N2}"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,8,0"/></Style>
        <Style x:Key="Estado" TargetType="TextBlock"><Setter Property="Text" Value="{Binding EstadoInsumos}"/><Setter Property="Foreground" Value="#92400E"/><Setter Property="Background" Value="#FEF3C7"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#124A91"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="6,8"/><Setter Property="MinHeight" Value="54"/><Setter Property="ContentTemplate" Value="{StaticResource EncabezadoTabla}"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#D9E2EF"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="AdicionalStockInfo" Visibility="Collapsed"/>
        <Border Background="#124A91" CornerRadius="12,12,0,0" Padding="24,16"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="34" Margin="0,0,16,0"/><StackPanel><TextBlock Text="GENERAR ORDEN DE TRABAJO" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="CabeceraText" Foreground="#DDEBFF" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DFED" BorderThickness="1" Padding="24,18" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Empresa:" Style="{StaticResource Etiqueta}" FontSize="14"/><TextBox Grid.Column="1" x:Name="EmpresaText" Style="{StaticResource Campo}" Margin="0,0,28,10"/><TextBlock Grid.Column="2" Text="Orden de Compra Cliente:" Style="{StaticResource Etiqueta}" FontSize="14"/><TextBox Grid.Column="3" x:Name="OrdenCompraText" Style="{StaticResource Campo}" Margin="0,0,0,10"/><TextBlock Grid.Row="1" Text="Fecha y hora de emisión:" Style="{StaticResource Etiqueta}" FontSize="14"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="FechaEmisionText" Style="{StaticResource Campo}" Margin="0,0,28,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Fecha entrega OT:" Style="{StaticResource Etiqueta}" FontSize="14"/><StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"><DatePicker x:Name="FechaEntregaPicker" Width="150" Height="34" SelectedDateFormat="Short"/><TextBlock x:Name="FechaEntregaReferenciaText" Foreground="#52647D" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#D5DFED" BorderThickness="1" Padding="14,12" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="4,0,4,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Detalle de productos" FontSize="21" FontWeight="Bold" Foreground="#172554" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="AgregarStockButton" Content="＋  Agregar adicional para stock" MinWidth="270" Height="40" Padding="16,8" HorizontalContentAlignment="Center" Background="White" Foreground="#1456A0" BorderBrush="#1456A0" Click="AgregarStock_Click"/></Grid><DataGrid Grid.Row="1" x:Name="DetallesGrid" MinWidth="1420" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" CanUserResizeColumns="True" EnableRowVirtualization="False" AlternationCount="2" HeadersVisibility="Column" GridLinesVisibility="None" BeginningEdit="DetallesGrid_BeginningEdit" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="66"/><Setter Property="Background" Value="White"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F7F9FC"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding CodigoProducto}" ElementStyle="{StaticResource NumeroDerecha}" Width="100"/><DataGridTemplateColumn Header="Producto" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NombreProducto}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Observación" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Observacion}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Observacion}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Ficha técnica" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button ToolTip="Abrir ficha técnica" Style="{StaticResource Ficha}" Click="ImprimirFicha_Click"><Path Width="18" Height="20" Stroke="#1261B0" StrokeThickness="1.8" Data="M2,1 L12,1 L17,6 L17,19 L2,19 Z M12,1 L12,6 L17,6 M5,10 L14,10 M5,14 L14,14"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Req. OC" Binding="{Binding CantidadRequeridaOc, StringFormat=N2}" ElementStyle="{StaticResource NumeroDerecha}" Width="82"/><DataGridTextColumn Header="Stock actual" Binding="{Binding StockAlmacen, StringFormat=N2}" ElementStyle="{StaticResource NumeroDerecha}" Width="88"/><DataGridTextColumn Header="Reservado en proceso" Binding="{Binding StockProcesoReservado, StringFormat=N2}" ElementStyle="{StaticResource NumeroDerecha}" Width="112"/><DataGridTemplateColumn Header="Déficit" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource Deficit}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Adicional stock" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding AdicionalStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat=N2}" Width="92" Height="34" HorizontalContentAlignment="Right" Padding="5" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AdicionalStockHabilitado}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Total a producir" Binding="{Binding TotalProduccion, StringFormat=N2}" ElementStyle="{StaticResource NumeroDerecha}" Width="112"/><DataGridTemplateColumn Header="Estado de insumos" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource Estado}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#D5DFED" BorderThickness="1" Padding="20,14" Margin="0,0,0,12"><StackPanel><TextBlock Text="Observaciones Generales (opcional)" FontSize="17" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,8"/><TextBox x:Name="ObservacionText" Height="72" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" BorderBrush="#A9B9D4" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="VistaPreviaButton" Content="▣  Vista previa de OT" Width="190" Height="42" Margin="0,0,12,0" Background="White" Foreground="#1456A0" BorderBrush="#1456A0" FontWeight="SemiBold" Click="VistaPrevia_Click"/><Button x:Name="GuardarButton" Content="▣  Guardar" Width="145" Height="42" Margin="0,0,12,0" IsDefault="True" Background="#16A34A" Foreground="White" BorderBrush="#16A34A" FontWeight="SemiBold" Click="Crear_Click"/><Button Content="✕  Cancelar" Width="145" Height="42" IsCancel="True" Background="#DC3B3B" Foreground="White" BorderBrush="#DC3B3B" FontWeight="SemiBold"/></StackPanel>
    </Grid>
</Window>
