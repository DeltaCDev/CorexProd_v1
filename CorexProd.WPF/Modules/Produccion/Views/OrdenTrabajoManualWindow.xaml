<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.OrdenTrabajoManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OT Manual - Abastecimiento de Stock"
        Height="720" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TextoCentro" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextoProducto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxHeight" Value="38"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="OT Manual - Abastecimiento de Stock" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Seleccione productos y cantidades a producir para abastecer stock." Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,10">
                <TextBlock Text="Buscar producto" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="BuscarProductoTextBox" Height="34" Padding="8,0" TextChanged="BuscarProducto_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,10">
                <StackPanel Width="150">
                    <TextBlock Text="Cantidad" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="CantidadTextBox" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Content="Agregar"
                        Width="105"
                        Height="34"
                        Margin="10,21,0,0"
                        Background="#0F766E"
                        Foreground="White"
                        BorderBrush="#0F766E"
                        Click="Agregar_Click"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Productos disponibles" Margin="0,0,12,0">
                <ListBox x:Name="ProductosListBox" MouseDoubleClick="ProductosListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" Foreground="#0F766E"/>
                                <TextBlock Text="{Binding NombreProducto}" TextWrapping="Wrap" Foreground="#0F172A"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="1" Grid.Row="1" Header="Productos para la OT Manual" Margin="12,0,0,0">
                <DataGrid x:Name="DetallesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          RowHeight="48"
                          ItemsSource="{Binding Detalles}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTemplateColumn Header="Producto" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreProducto}" Style="{StaticResource TextoProducto}" ToolTip="{Binding NombreProducto}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="105" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTemplateColumn Header="Acciones" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Quitar" Padding="8,3" Foreground="#DC2626" Click="Quitar_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Observacion general de la OT (opcional)" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="ObservacionTextBox" Height="58" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Validar insumos y guardar"
                    Width="175"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#16A34A"
                    Foreground="White"
                    BorderBrush="#16A34A"
                    IsDefault="True"
                    Click="Guardar_Click"/>
            <Button Content="Cancelar" Width="105" Height="38" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
