<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.ServicioExternoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servicio externo" Width="560" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TituloText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
        <TextBlock x:Name="ProductoText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel x:Name="ProveedorPanel" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Proveedor / servicio externo:" FontWeight="SemiBold"/>
            <TextBox x:Name="ProveedorTextBox" Height="34" Margin="0,4,0,0" Padding="7"/>
        </StackPanel>
        <StackPanel x:Name="FechaPanel" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Fecha estimada de retorno (opcional):" FontWeight="SemiBold"/>
            <DatePicker x:Name="FechaDatePicker" Height="34" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel x:Name="CantidadPanel" Grid.Row="4" Margin="0,0,0,10">
            <TextBlock x:Name="CantidadLabel" Text="Cantidad:" FontWeight="SemiBold"/>
            <TextBox x:Name="CantidadTextBox" Height="34" Margin="0,4,0,0" Padding="7"/>
        </StackPanel>
        <StackPanel Grid.Row="5">
            <TextBlock Text="Observación del envío (opcional):" FontWeight="SemiBold"/>
            <TextBox x:Name="ObservacionTextBox" Height="110" Margin="0,4,0,0" Padding="7" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="Confirmar" Width="140" Height="38" Margin="0,0,12,0" IsDefault="True" Click="Confirmar_Click"/>
            <Button Content="Cancelar" Width="120" Height="38" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
