<Window x:Class="CorexProd.WPF.Modules.Produccion.Views.NuevaOrdenTrabajoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Orden de Trabajo"
        Height="720" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="TextoDosLineas" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="MaxHeight" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="TextoCentro" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Nueva OT" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Seleccione el origen de la orden de trabajo" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
            <Button x:Name="StockButton" Height="54" Margin="0,0,8,0" Click="Stock_Click"
                    Background="White" BorderBrush="#CBD5E1" Foreground="#0F172A">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"/>
                    <TextBlock Text="Abastecimiento de stock" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="RegularizacionButton" Height="54" Margin="8,0,0,0" Click="Regularizacion_Click"
                    Background="#0F766E" BorderBrush="#0F766E" Foreground="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"/>
                    <TextBlock Text="Regularizacion de OT" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Buscar" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,8,0"/>
                <TextBox x:Name="BuscarTextBox" Width="280" Height="32" Padding="8,0" TextChanged="Buscar_Changed"/>
                <TextBlock x:Name="ResumenText" VerticalAlignment="Center" Margin="18,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="OT pendientes para regularizar" Margin="0,0,8,0">
                <DataGrid x:Name="OtGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="54" SelectionChanged="OtGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OT para regularizar" Binding="{Binding NumeroOT}" Width="135" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTextColumn Header="Nro OCI" Binding="{Binding NumeroOci}" Width="95" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}" Width="125" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTextColumn Header="Pend." Binding="{Binding TotalPendiente, StringFormat=N2}" Width="75" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTemplateColumn Header="Cliente" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreCliente}"
                                               Style="{StaticResource TextoDosLineas}"
                                               ToolTip="{Binding NombreCliente}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Grid.Row="1" Header="Productos con cantidad faltante" Margin="8,0,0,0">
                <DataGrid x:Name="ProductosGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoProducto}" Width="90" ElementStyle="{StaticResource TextoCentro}"/>
                        <DataGridTemplateColumn Header="Producto" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreProducto}"
                                               Style="{StaticResource TextoDosLineas}"
                                               ToolTip="{Binding NombreProducto}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Faltante" Binding="{Binding CantidadRequerida, StringFormat=N3}" Width="90" ElementStyle="{StaticResource TextoCentro}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="GenerarButton" Content="Continuar" Width="110" Height="36" Margin="0,0,10,0"
                    Background="#16A34A" Foreground="White" BorderBrush="#16A34A" Click="Generar_Click"/>
            <Button Content="Cerrar" Width="100" Height="36" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
