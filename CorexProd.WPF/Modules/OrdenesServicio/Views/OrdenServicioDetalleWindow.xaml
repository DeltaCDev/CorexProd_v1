<Window x:Class="CorexProd.WPF.Modules.OrdenesServicio.Views.OrdenServicioDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="1050"
        Height="680"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="28,18,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Titulo}" FontSize="21" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding Orden.EstadoVisual}" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding TabSeleccionado}">
            <TabItem Header="Detalle">
                <Grid Margin="18,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Proveedor" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.NombreProveedor}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.TipoServicioNombre}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.Cliente}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Responsable" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.Responsable}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.FechaVisual}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Compromiso" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.FechaComprometidaVisual}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="OCI" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.OciRelacionada}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="OT" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text="{Binding Orden.OtRelacionada}" Style="{StaticResource Valor}"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Grid.Row="1" Background="White" BorderBrush="#D7E0EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Observaciones internas (resumen)" Style="{StaticResource Etiqueta}"/>
                                <TextBlock Text="{Binding Orden.ObservacionesInternas}" Style="{StaticResource Valor}" MinHeight="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Observaciones para proveedor (PDF)" Style="{StaticResource Etiqueta}"/>
                                <TextBlock Text="{Binding Orden.Observaciones}" Style="{StaticResource Valor}" MinHeight="34"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Orden.Detalles}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="180"/>
                            <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="80"/>
                            <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitario, StringFormat=S/ {0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=S/ {0:N2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Movimientos">
                <DataGrid Margin="18,12,0,0" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="100"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="180"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadMovimiento, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Pendiente" Binding="{Binding CantidadPendiente, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioRegistro}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Pagos">
                <Grid Margin="18,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Monto" Foreground="#047857"/>
                                <TextBlock Text="{Binding Orden.Total, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#047857"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Pagado" Foreground="#047857"/>
                                <TextBlock Text="{Binding Orden.TotalPagado, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#047857"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Pendiente" Foreground="#B91C1C"/>
                                <TextBlock Text="{Binding Orden.SaldoPendiente, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#B91C1C"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Orden.Pagos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoPago}" Width="130"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=S/ {0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="Medio" Binding="{Binding MedioPago}" Width="150"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding DestinoPagoVisual}" Width="150"/>
                            <DataGridTextColumn Header="Operacion" Binding="{Binding NumeroOperacion}" Width="160"/>
                            <DataGridTextColumn Header="Observacion" Binding="{Binding ObservacionUsuarioVisual}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Fotos">
                <Grid Margin="18,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Orden.Fotos}"
                              SelectedItem="{Binding FotoSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Ver" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ver" Style="{StaticResource Boton}" MinWidth="54" Height="26" Padding="8,0" Click="VerFotoFila_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Titulo" Binding="{Binding Titulo}" Width="180"/>
                            <DataGridTextColumn Header="Ubicacion PDF" Binding="{Binding UbicacionPdf}" Width="130"/>
                            <DataGridTextColumn Header="Archivo" Binding="{Binding NombreArchivo}" Width="*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Background="White" BorderBrush="#D7E0EE" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding FotoActualTexto}" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource Boton}" Click="AbrirFoto_Click" Visibility="{Binding HayFotos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding FotoSeleccionada.RutaArchivoUri}" Stretch="Uniform" Margin="8"/>
                                    <TextBlock Text="Sin fotos registradas"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               Visibility="{Binding SinFotos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Anterior" Style="{StaticResource Boton}" Click="FotoAnterior_Click" Margin="0,0,8,0" Visibility="{Binding HayFotos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Siguiente" Style="{StaticResource Boton}" Click="FotoSiguiente_Click" Visibility="{Binding HayFotos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Historial">
                <DataGrid Margin="18,12,0,0" ItemsSource="{Binding Orden.Historial}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHoraVisual}" Width="150"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="180"/>
                        <DataGridTextColumn Header="Accion" Binding="{Binding Accion}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Style="{StaticResource Boton}" HorizontalAlignment="Right" Margin="0,12,0,0" Content="Cerrar" Click="Cerrar_Click"/>
    </Grid>
</Window>
