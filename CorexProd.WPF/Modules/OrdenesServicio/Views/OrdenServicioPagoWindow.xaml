<Window x:Class="CorexProd.WPF.Modules.OrdenesServicio.Views.OrdenServicioPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar pago"
        Width="1020"
        Height="620"
        MinWidth="940"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Registrar pago" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding Orden.NumeroOrden}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Orden.Total, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Pagado" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Orden.TotalPagado, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Saldo pendiente" Foreground="#92400E"/>
                        <TextBlock Text="{Binding Orden.SaldoPendiente, StringFormat=S/ {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pagos registrados" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Orden.Pagos}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoPago}" Width="120"/>
                            <DataGridTextColumn Header="Medio" Binding="{Binding MedioPago}" Width="130"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding DestinoPagoVisual}" Width="130"/>
                            <DataGridTextColumn Header="Operacion" Binding="{Binding NumeroOperacion}" Width="120"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=S/ {0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Observacion" Binding="{Binding ObservacionUsuarioVisual}" Width="180"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioRegistro}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Forma de pago" Style="{StaticResource Etiqueta}"/>
                        <ComboBox Height="32"
                                  ItemsSource="{Binding FormasPago}"
                                  SelectedItem="{Binding FormaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Nombre"
                                  SelectionChanged="FormaPago_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,10" Visibility="{Binding DestinoVisibility}">
                        <TextBlock Text="{Binding DestinoLabel}" Style="{StaticResource Etiqueta}"/>
                        <TextBox Style="{StaticResource CampoTexto}" Text="{Binding DestinoPago, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,10" Visibility="{Binding OperacionVisibility}">
                        <TextBlock Text="Codigo operacion (opcional)" Style="{StaticResource Etiqueta}"/>
                        <TextBox Style="{StaticResource CampoTexto}" Text="{Binding NumeroOperacion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock Text="Monto" Style="{StaticResource Etiqueta}"/>
                        <TextBox Style="{StaticResource CampoTexto}" Text="{Binding Importe, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                        <TextBlock Text="Observacion" Style="{StaticResource Etiqueta}"/>
                        <TextBox Height="54" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Click="Guardar_Click" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Style="{StaticResource Boton}" Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
