<Window x:Class="CorexProd.WPF.Modules.OrdenesServicio.Views.OrdenServicioAprobacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aprobar orden de servicio"
        Width="420"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Aprobar orden de servicio" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Ingrese un usuario autorizado y su clave de aprobacion OS." Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
            <StackPanel>
                <TextBlock Text="Usuario aprobador" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="UsuarioTextBox" Style="{StaticResource CampoTexto}" Margin="0,0,0,12"/>
                <TextBlock Text="Clave aprobacion OS" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="ClavePasswordBox" Height="32" Padding="8,0" MaxLength="4" VerticalContentAlignment="Center" PreviewTextInput="ClavePasswordBox_PreviewTextInput"/>
                <TextBlock Text="La clave debe tener 4 digitos numericos." Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Aprobar" Style="{StaticResource BotonPrimario}" Click="Aprobar_Click" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Style="{StaticResource Boton}" Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
