<UserControl x:Class="CorexProd.WPF.Modules.DestajoPagos.Views.ReportesPagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="CajaSeccion" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="MinColumnWidth" Value="96"/>
            <Setter Property="ColumnWidth" Value="Auto"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0"
                     Columns="5"
                     Margin="0,0,0,12">
            <Border Style="{StaticResource CajaSeccion}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Ingresos" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalIngresosPeriodo, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaSeccion}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Descuentos" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalDescuentosPeriodo, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaSeccion}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Neto" Foreground="#64748B"/>
                    <TextBlock Text="{Binding NetoPeriodo, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaSeccion}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Pagado" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalPagadoPeriodo, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaSeccion}">
                <StackPanel>
                    <TextBlock Text="Saldo" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SaldoPendientePeriodo, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,8">
            <Button Content="Calcular periodo"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding CalcularPeriodoCommand}"/>
            <Button Content="Recalcular trabajador"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding RecalcularTrabajadorCommand}"/>
            <Button Content="Confirmar cálculo"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding ConfirmarCalculoPeriodoCommand}"/>
            <Button Content="Boletas seleccionadas"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding DescargarBoletasSeleccionadasCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=ResumenesGrid}"/>
            <Button Content="Todas las boletas"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding DescargarTodasBoletasCommand}"/>
            <Button Content="Resumen CSV"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding ExportarResumenPeriodoCommand}"/>
            <Button Content="Operativo CSV"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding ExportarReporteOperativoCommand}"/>
            <Button Content="Pagos CSV"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding ExportarReportePagosCommand}"/>
            <Button Content="Préstamos CSV"
                    Style="{StaticResource BotonAccion}"
                    Command="{Binding ExportarReportePrestamosCommand}"/>
        </WrapPanel>

        <DataGrid x:Name="ResumenesGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Resumenes}"
                  SelectedItem="{Binding ResumenSeleccionado}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  MinHeight="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trabajador" Binding="{Binding NombreTrabajador}" Width="230"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTrabajador}" Width="140"/>
                <DataGridTextColumn Header="Medio" Binding="{Binding MedioPagoPreferido}" Width="110"/>
                <DataGridTextColumn Header="Saldo anterior" Binding="{Binding SaldoAnterior, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="Ingresos" Binding="{Binding TotalIngresos, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="Descuentos" Binding="{Binding TotalDescuentos, StringFormat={}{0:N2}}" Width="115"/>
                <DataGridTextColumn Header="Neto" Binding="{Binding NetoCalculado, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="Por pagar" Binding="{Binding TotalPorPagar, StringFormat={}{0:N2}}" Width="105"/>
                <DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="Cálculo" Binding="{Binding EstadoCalculo}" Width="105"/>
                <DataGridTextColumn Header="Fecha cálculo" Binding="{Binding FechaCalculo, StringFormat=g}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoPeriodo}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Style="{StaticResource CajaSeccion}"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding AlertasCalculo.Count, StringFormat=Alertas del cálculo: {0}}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding AlertasCalculo}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severidad" Binding="{Binding Severidad}" Width="100"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoAlerta}" Width="180"/>
                        <DataGridTextColumn Header="Trabajador" Binding="{Binding NombreTrabajador}" Width="220"/>
                        <DataGridTextColumn Header="Mensaje" Binding="{Binding Mensaje}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
