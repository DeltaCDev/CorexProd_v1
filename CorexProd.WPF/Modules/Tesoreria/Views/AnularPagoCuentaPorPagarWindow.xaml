<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.AnularPagoCuentaPorPagarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anular Pago"
        Width="620"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="EtiquetaDato" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValorDato" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ANULAR PAGO" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="El pago se conservará como ANULADO y se recalcularán los saldos." Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="PROVEEDOR" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding Proveedor}" Style="{StaticResource ValorDato}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="LETRA / CUOTA" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding Pago.ReferenciaCuota}" Style="{StaticResource ValorDato}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="FECHA DE PAGO" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding Pago.FechaPago, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDato}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="IMPORTE" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding Pago.Importe, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="BANCO / CUENTA" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding BancoCuenta}" Style="{StaticResource ValorDato}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="N.° OPERACIÓN" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock Text="{Binding Pago.NumeroOperacion}" Style="{StaticResource ValorDato}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Motivo de anulación" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="MotivoTextBox"
                             Height="110"
                             Padding="8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="ErrorTextBlock"
                               Text="Debe ingresar el motivo de anulación."
                               Foreground="#DC2626"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Style="{StaticResource Boton}" Click="Cancelar_Click" Margin="0,0,10,0"/>
            <Button Content="Anular Pago" Style="{StaticResource BotonPeligro}" Click="Confirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
