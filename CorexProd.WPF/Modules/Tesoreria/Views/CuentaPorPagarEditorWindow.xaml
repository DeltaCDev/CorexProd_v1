<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.CuentaPorPagarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="1240"
        Height="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CampoCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Cabecera" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                                <TextBlock Style="{StaticResource LabelCampo}"><Run Text="Proveedor "/><Run Text="*" Foreground="#DC2626"/></TextBlock>
                                <ComboBox Style="{StaticResource CampoCombo}" ItemsSource="{Binding Proveedores}" DisplayMemberPath="ProveedorBusqueda" SelectedItem="{Binding ProveedorSeleccionado}" IsTextSearchEnabled="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,14">
                                <TextBlock Style="{StaticResource LabelCampo}"><Run Text="Tipo obligación "/><Run Text="*" Foreground="#DC2626"/></TextBlock>
                                <ComboBox Style="{StaticResource CampoCombo}" ItemsSource="{Binding TiposObligacion}" DisplayMemberPath="Nombre" SelectedItem="{Binding TipoObligacionSeleccionado}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,14">
                                <TextBlock Style="{StaticResource LabelCampo}"><Run Text="Fecha documento "/><Run Text="*" Foreground="#DC2626"/></TextBlock>
                                <DatePicker Height="30" SelectedDate="{Binding FechaDocumento}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,14,14">
                                <TextBlock Style="{StaticResource LabelCampo}"><Run Text="Moneda "/><Run Text="*" Foreground="#DC2626"/></TextBlock>
                                <ComboBox Style="{StaticResource CampoCombo}" ItemsSource="{Binding Monedas}" SelectedItem="{Binding Moneda}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Total neto por pagar"/>
                                <TextBox Style="{StaticResource CampoTexto}" Text="{Binding ImporteTotalTexto, Mode=OneWay}" IsReadOnly="True" Background="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5">
                                <TextBlock Text="Observación" Style="{StaticResource LabelCampo}"/>
                                <TextBox Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="DOCUMENTOS ASOCIADOS" FontSize="16" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Width="165" Height="30" Command="{Binding AgregarDocumentoCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Agregar documento"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding Documentos}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" MinHeight="145" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tipo documento" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="28" ItemsSource="{Binding DataContext.TiposDocumento, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="NombreTipoDocumento" SelectedItem="{Binding TipoDocumentoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Serie" Binding="{Binding Serie, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="Número" Binding="{Binding Numero, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTemplateColumn Header="Fecha emisión" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker Height="28" SelectedDate="{Binding FechaEmision, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Efecto" Binding="{Binding ImporteConEfectoTexto, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Eliminar" Height="28" Command="{Binding DataContext.QuitarDocumentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding TituloCuotas}" FontSize="16" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Width="170" Height="30" Command="{Binding AgregarCuotaCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="Agregar letra/cuota"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding Cuotas}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" MinHeight="170" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nro letra" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Height="28"
                                                     Text="{Binding NumeroLetra, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding DataContext.EsLetrasPorPagar, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cuota" Binding="{Binding NumeroCuota, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="Total cuotas" Binding="{Binding TotalCuotas, UpdateSourceTrigger=PropertyChanged}" Width="92"/>
                                <DataGridTemplateColumn Header="Fecha giro" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker Height="28"
                                                        SelectedDate="{Binding FechaGiro, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding DataContext.EsLetrasPorPagar, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fecha vencimiento" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker Height="28" SelectedDate="{Binding FechaVencimiento, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Eliminar" Height="28" Command="{Binding DataContext.QuitarCuotaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="135"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Resumen documental" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Text="Total Facturas:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalFacturasTexto}" TextAlignment="Right" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="(-) Notas Crédito:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalNotasCreditoTexto}" TextAlignment="Right" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="Total Cuotas:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalCuotasTexto}" TextAlignment="Right" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Text="Total Neto:" FontWeight="Bold" Foreground="#2563EB"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalNetoPorPagarTexto}" TextAlignment="Right" FontWeight="Bold" Foreground="#2563EB"/>
                            <TextBlock Grid.Row="5" Text="Diferencia Cuotas:" Foreground="#92400E" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DiferenciaCuotasTexto}" TextAlignment="Right" Foreground="#92400E" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Width="120" Height="34" Margin="0,0,10,0" Command="{Binding CancelarCommand}"/>
            <Button Content="Guardar" Width="120" Height="34" Background="#16A34A" BorderBrush="#16A34A" Foreground="White" Command="{Binding GuardarCommand}"/>
        </StackPanel>
    </Grid>
</Window>
