<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.SeguroEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nuevo Seguro" Width="820" Height="700" WindowStartupLocation="CenterOwner"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="DATOS DEL SEGURO" FontWeight="Bold" FontSize="20"/><WrapPanel><StackPanel Margin="5"><TextBlock Text="Tipo de seguro"/><TextBox x:Name="TipoTextBox" Width="220"/></StackPanel><StackPanel Margin="5"><TextBlock Text="N.º póliza"/><TextBox x:Name="PolizaTextBox" Width="180"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Aseguradora"/><ComboBox x:Name="AseguradoraComboBox" Width="220" DisplayMemberPath="Nombre"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Periodicidad"/><ComboBox x:Name="PeriodicidadComboBox" Width="150"/></StackPanel></WrapPanel><WrapPanel><StackPanel Margin="5"><TextBlock Text="Inicio cobertura"/><DatePicker x:Name="InicioCoberturaPicker"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Fin cobertura"/><DatePicker x:Name="FinCoberturaPicker"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Moneda"/><ComboBox x:Name="MonedaComboBox" Width="100"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Monto original"/><TextBox x:Name="MontoTextBox" Width="120"/></StackPanel></WrapPanel><TextBlock Text="DATOS GENERALES" FontWeight="Bold" FontSize="16" Margin="5,16,5,4"/><WrapPanel><StackPanel Margin="5"><TextBlock Text="Titular / responsable"/><TextBox x:Name="TitularTextBox" Width="280"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Concepto"/><TextBox x:Name="ConceptoTextBox" Width="280"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Referencia"/><TextBox x:Name="ReferenciaTextBox" Width="180"/></StackPanel></WrapPanel><StackPanel Margin="5"><TextBlock Text="Observación"/><TextBox x:Name="ObservacionTextBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel><TextBlock Text="PERÍODOS" FontWeight="Bold" FontSize="16" Margin="5,16,5,4"/><WrapPanel><RadioButton x:Name="UnicoRadio" Content="Pago único" IsChecked="True" Margin="5"/><RadioButton x:Name="CuotasRadio" Content="Cuotas reales" Margin="5"/><StackPanel Margin="5"><TextBlock Text="Total cuotas"/><TextBox x:Name="TotalCuotasTextBox" Width="80" Text="1"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Vencimiento inicial"/><DatePicker x:Name="VencimientoPicker"/></StackPanel></WrapPanel><TextBlock Text="Para cuotas reales se generará un borrador editable con importes iguales; revíselo antes de guardar." Foreground="#64748B" TextWrapping="Wrap" Margin="5"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,20"><Button Content="Cancelar" Click="Cancelar_Click" Margin="5"/><Button Content="Guardar" Click="Guardar_Click" Margin="5"/></StackPanel></StackPanel></ScrollViewer></Window>
