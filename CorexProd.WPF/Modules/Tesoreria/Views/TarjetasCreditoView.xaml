<UserControl x:Class="CorexProd.WPF.Modules.Tesoreria.Views.TarjetasCreditoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="TARJETAS DE CRÉDITO" FontSize="21" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock x:Name="ResumenTextBlock" Foreground="#64748B" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Nueva tarjeta" Click="Nueva_Click" Padding="14,6" Margin="0,0,8,0" Background="#2563EB" Foreground="White" />
          <Button Content="Actualizar" Click="Actualizar_Click" Padding="14,6" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Buscar" FontWeight="SemiBold" />
            <TextBox x:Name="TextoTextBox" Width="250" Height="30" TextChanged="Filtro_Changed" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Entidad financiera" FontWeight="SemiBold" />
            <ComboBox x:Name="EntidadComboBox" Width="220" Height="30" DisplayMemberPath="Nombre" SelectedValuePath="IdEntidadFinanciera" SelectionChanged="Filtro_Changed" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Estado" FontWeight="SemiBold" />
            <ComboBox x:Name="EstadoComboBox" Width="145" Height="30" SelectionChanged="Filtro_Changed">
              <ComboBoxItem Content="Todos" IsSelected="True" />
              <ComboBoxItem Content="ACTIVA" />
              <ComboBoxItem Content="INACTIVA" />
              <ComboBoxItem Content="ANULADA" />
            </ComboBox>
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>
    <DataGrid Grid.Row="1" x:Name="TarjetasDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="40" Background="White" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Acciones" Width="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Ver" Tag="{Binding}" Click="Ver_Click" Margin="2" />
                <Button Content="Editar" Tag="{Binding}" Click="Editar_Click" Margin="2">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="Períodos" Tag="{Binding}" Click="Periodos_Click" Margin="2" />
                <Button Content="Estado" Tag="{Binding}" Click="Estado_Click" Margin="2">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="Anular" Tag="{Binding}" Click="Anular_Click" Margin="2">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Entidad financiera" Binding="{Binding EntidadFinanciera}" Width="170" />
        <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120" />
        <DataGridTextColumn Header="Últimos 4" Binding="{Binding Ultimos4}" Width="80" />
        <DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="160" />
        <DataGridTextColumn Header="Empresa responsable" Binding="{Binding EmpresaResponsable}" Width="170" />
        <DataGridTemplateColumn Header="Monedas" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding MonedasHabilitadas}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,4,0" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Corte" Binding="{Binding DiaCorte}" Width="65" />
        <DataGridTextColumn Header="Venc." Binding="{Binding DiaPago}" Width="65" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="95" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
