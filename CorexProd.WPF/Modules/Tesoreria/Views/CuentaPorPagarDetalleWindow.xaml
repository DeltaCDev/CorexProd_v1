<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.CuentaPorPagarDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Cuenta por Pagar"
        Width="1080"
        Height="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="EtiquetaDato" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValorDato" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="EstadoBadge" TargetType="Border">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstadoTexto" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Icono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AnularPagoButton" TargetType="Button" BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADO">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding IdCuentaPorPagar, StringFormat=Cuenta por Pagar #{0}}" FontSize="24" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Right" Style="{StaticResource EstadoBadge}">
                <TextBlock Text="{Binding Estado}" Style="{StaticResource EstadoTexto}"/>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                            <TextBlock Text="PROVEEDOR" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding NombreProveedor}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,14">
                            <TextBlock Text="TIPO" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding TipoObligacion}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,14">
                            <TextBlock Text="FECHA DOCUMENTO" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding FechaDocumento, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,14,14">
                            <TextBlock Text="MONEDA" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding Moneda}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,14">
                            <TextBlock Text="TOTAL NETO" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding ImporteTotal, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                            <TextBlock Text="TOTAL PAGADO" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding TotalPagado, StringFormat=N2}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,14">
                            <TextBlock Text="SALDO" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding SaldoPendiente, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,14">
                            <TextBlock Text="ORIGEN" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding OrigenTipo}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="AUDITORÍA" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding UsuarioRegistro}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="5">
                            <TextBlock Text="OBSERVACIÓN" Style="{StaticResource EtiquetaDato}"/>
                            <TextBlock Text="{Binding Observacion}" Style="{StaticResource ValorDato}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DOCUMENTOS" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL FACTURAS" Style="{StaticResource EtiquetaDato}"/>
                                    <TextBlock Text="{Binding TotalDocumentosPositivos, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FBBF24" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="(-) NOTAS DE CRÉDITO" Style="{StaticResource EtiquetaDato}"/>
                                    <TextBlock Text="{Binding TotalNotasCredito, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="TOTAL NETO POR PAGAR" Style="{StaticResource EtiquetaDato}"/>
                                    <TextBlock Text="{Binding TotalNetoDocumental, StringFormat=N2}" Style="{StaticResource ValorDato}" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Documentos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding NombreTipoDocumento}" Width="170"/>
                                <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="90"/>
                                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="110"/>
                                <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="150"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaEmision, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Efecto" Binding="{Binding EfectoTexto}" Width="80"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="LETRAS / CUOTAS DE FACTURA" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Cuotas}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Letra" Binding="{Binding NumeroLetra}" Width="130"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoCuota}" Width="110"/>
                                <DataGridTextColumn Header="Cuota" Binding="{Binding NumeroCuota}" Width="70"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalCuotas}" Width="70"/>
                                <DataGridTextColumn Header="Giro" Binding="{Binding FechaGiro, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HISTORIAL DE PAGOS" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Pagos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="130">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Acción" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AnularPagoButton}"
                                                    ToolTip="Anular pago"
                                                    Click="AnularPago_Click"
                                                    Tag="{Binding}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icono}" Foreground="#DC2626"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Letra / cuota" Binding="{Binding ReferenciaCuota}" Width="130"/>
                                <DataGridTextColumn Header="Banco" Binding="{Binding Banco}" Width="150"/>
                                <DataGridTextColumn Header="Cuenta" Binding="{Binding NumeroCuenta}" Width="145"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="N.° Operación" Binding="{Binding NumeroOperacion}" Width="130"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioRegistro}" Width="140"/>
                                <DataGridTextColumn Header="Usuario anulación" Binding="{Binding UsuarioAnulacion}" Width="145"/>
                                <DataGridTextColumn Header="Fecha anulación" Binding="{Binding FechaAnulacion, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                                <DataGridTextColumn Header="Motivo anulación" Binding="{Binding MotivoAnulacion}" Width="190"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HISTORIAL GENERAL" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Historial}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="135"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="150"/>
                                <DataGridTextColumn Header="Estado anterior" Binding="{Binding EstadoAnterior}" Width="120"/>
                                <DataGridTextColumn Header="Estado nuevo" Binding="{Binding EstadoNuevo}" Width="120"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="{Binding ImporteTotal, StringFormat=Total: {0:N2}}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,18,0"/>
            <Button Content="Aceptar" Width="100" Height="32" Click="Cerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
