<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.TarjetaCreditoEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tarjeta de crédito" Width="760" Height="610" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TituloTextBlock" Text="NUEVA TARJETA DE CRÉDITO" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="No se registra número completo, CVV, PIN ni códigos de seguridad." Foreground="#64748B" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,12,12">
          <TextBlock Text="Entidad financiera *" />
          <ComboBox x:Name="EntidadComboBox" Height="32" DisplayMemberPath="Nombre" SelectedValuePath="IdEntidadFinanciera" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,0,12">
          <TextBlock Text="Alias *" />
          <TextBox x:Name="AliasTextBox" Height="32" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,12,12">
          <TextBlock Text="Últimos 4 dígitos" />
          <TextBox x:Name="Ultimos4TextBox" Height="32" MaxLength="4" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
          <TextBlock Text="Titular *" />
          <TextBox x:Name="TitularTextBox" Height="32" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,12,12">
          <TextBlock Text="Empresa responsable *" />
          <ComboBox x:Name="EmpresaComboBox" Height="32" DisplayMemberPath="Nombre" SelectedValuePath="IdEmpresa" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
          <TextBlock Text="Monedas habilitadas *" />
          <StackPanel Orientation="Horizontal"><CheckBox x:Name="PenCheckBox" Content="PEN" Margin="0,8,16,0" /><CheckBox x:Name="UsdCheckBox" Content="USD" Margin="0,8,0,0" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,12,12">
          <TextBlock Text="Día de corte" />
          <TextBox x:Name="DiaCorteTextBox" Height="32" />
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
          <TextBlock Text="Día de vencimiento" />
          <TextBox x:Name="DiaPagoTextBox" Height="32" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,12,0">
          <TextBlock Text="Estado" />
          <ComboBox x:Name="EstadoComboBox" Height="32">
            <ComboBoxItem Content="ACTIVA" IsSelected="True" />
            <ComboBoxItem Content="INACTIVA" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1">
          <TextBlock Text="Observación" />
          <TextBox x:Name="ObservacionTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
      <Button Content="Guardar" Click="Guardar_Click" Padding="14,6" Background="#2563EB" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
