<UserControl x:Class="CorexProd.WPF.Modules.Tesoreria.Views.SegurosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><DockPanel><StackPanel><TextBlock Text="SEGUROS" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding Resumen}" Foreground="#64748B"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Nuevo Seguro" Command="{Binding NuevoCommand}" Margin="4"/><Button Content="Actualizar" Command="{Binding ActualizarCommand}" Margin="4"/></StackPanel></DockPanel><WrapPanel Margin="0,14,0,0"><TextBox Width="220" Margin="4" Text="{Binding TextoBusqueda,UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="180" Margin="4" ItemsSource="{Binding Aseguradoras}" DisplayMemberPath="Nombre" SelectedItem="{Binding AseguradoraFiltro}"/><ComboBox Width="130" Margin="4" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoFiltro}"/><ComboBox Width="100" Margin="4" ItemsSource="{Binding Monedas}" SelectedItem="{Binding MonedaFiltro}"/></WrapPanel></StackPanel></Border><DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Seguros}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTemplateColumn Header="Acciones" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Ver" Command="{Binding DataContext.VerCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2"/><Button Content="Editar" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding Estado}" Value="ANULADA"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Anular" Command="{Binding DataContext.AnularCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding Estado}" Value="ANULADA"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Tipo" Binding="{Binding TipoSeguro}" Width="*"/><DataGridTextColumn Header="Póliza" Binding="{Binding NumeroPoliza}" Width="130"/><DataGridTextColumn Header="Aseguradora" Binding="{Binding Aseguradora}" Width="180"/><DataGridTextColumn Header="Cobertura inicio" Binding="{Binding FechaInicioCobertura,StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Cobertura fin" Binding="{Binding FechaFinCobertura,StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Periodicidad" Binding="{Binding Periodicidad}" Width="105"/><DataGridTextColumn Header="Mon." Binding="{Binding Moneda}" Width="60"/><DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="160"/><DataGridTextColumn Header="Empresa" Binding="{Binding EmpresaResponsable}" Width="150"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/></DataGrid.Columns></DataGrid></Grid></UserControl>
