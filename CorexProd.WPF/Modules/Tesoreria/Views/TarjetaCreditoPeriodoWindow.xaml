<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.TarjetaCreditoPeriodoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Período de tarjeta" Width="620" Height="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,10,12">
        <TextBlock Text="Año *" />
        <TextBox x:Name="AnioTextBox" Height="32" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,0,12">
        <TextBlock Text="Mes *" />
        <TextBox x:Name="MesTextBox" Height="32" />
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,0,10,12">
        <TextBlock Text="Fecha de corte *" />
        <DatePicker x:Name="CorteDatePicker" Height="32" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
        <TextBlock Text="Fecha de vencimiento *" />
        <DatePicker x:Name="VencimientoDatePicker" Height="32" />
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,0,10,12">
        <TextBlock Text="Importe PEN (opcional)" />
        <TextBox x:Name="ImportePenTextBox" Height="32" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
        <TextBlock Text="Importe USD (opcional)" />
        <TextBox x:Name="ImporteUsdTextBox" Height="32" />
      </StackPanel>
      <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
        <TextBlock Text="Observación" />
        <TextBox x:Name="ObservacionTextBox" Height="85" TextWrapping="Wrap" AcceptsReturn="True" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
      <Button Content="Guardar" Click="Guardar_Click" Padding="14,6" />
    </StackPanel>
  </Grid>
</Window>
