<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.SeguroDetalleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalle de Seguro" Width="1050" Height="680" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TituloTextBlock" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="ResumenTextBlock" Foreground="#475569"/><WrapPanel Margin="0,8"><Button Content="Registrar pago" Click="RegistrarPago_Click" Margin="3" x:Name="PagarButton"/><Button Content="Anular período" Click="AnularPeriodo_Click" Margin="3" x:Name="AnularPeriodoButton"/><Button Content="Anular pago" Click="AnularPago_Click" Margin="3" x:Name="AnularPagoButton"/></WrapPanel></StackPanel><TabControl Grid.Row="1"><TabItem Header="Períodos"><DataGrid x:Name="PeriodosGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Período" Binding="{Binding CuotaTexto}" Width="120"/><DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento,StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="Importe" Binding="{Binding Importe,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Pagos"><DataGrid x:Name="PagosGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Historial"><DataGrid x:Name="HistorialGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem></TabControl></Grid></Window>
