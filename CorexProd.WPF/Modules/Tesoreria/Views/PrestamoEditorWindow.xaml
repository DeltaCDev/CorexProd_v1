<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.PrestamoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prestamo"
        Width="1180"
        Height="760"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Campo" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CeldaTexto" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Titulo}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0"
                    Visibility="{Binding MostrarAlertaEdicion, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding AlertaEdicion}" Foreground="#92400E" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Entidad financiera *" Style="{StaticResource Etiqueta}"/>
                            <ComboBox Style="{StaticResource Campo}" ItemsSource="{Binding EntidadesFinancieras}" DisplayMemberPath="EntidadBusqueda" SelectedItem="{Binding EntidadSeleccionada}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Text="Tipo titular *" Style="{StaticResource Etiqueta}"/>
                            <ComboBox Style="{StaticResource Campo}" ItemsSource="{Binding TipoTitulares}" SelectedItem="{Binding TipoTitular}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="Empresa titular" Style="{StaticResource Etiqueta}"/>
                            <ComboBox Style="{StaticResource Campo}" ItemsSource="{Binding Empresas}" DisplayMemberPath="Nombre" SelectedItem="{Binding EmpresaTitularSeleccionada}" IsEnabled="{Binding EsTitularEmpresa}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="Empresa responsable" Style="{StaticResource Etiqueta}"/>
                            <ComboBox Style="{StaticResource Campo}" ItemsSource="{Binding Empresas}" DisplayMemberPath="Nombre" SelectedItem="{Binding EmpresaResponsableSeleccionada}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,12">
                            <TextBlock Text="Nombre titular *" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding NombreTitular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="Codigo referencia" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding CodigoReferencia, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="Numero contrato" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding NumeroContrato, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,12">
                            <TextBlock Text="Concepto *" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="Numero operacion" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding NumeroOperacion, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="Fecha inicio *" Style="{StaticResource Etiqueta}"/>
                            <DatePicker Style="{StaticResource Campo}" SelectedDate="{Binding FechaInicio}" IsEnabled="{Binding PuedeEditarFinanciero}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Moneda *" Style="{StaticResource Etiqueta}"/>
                            <ComboBox Style="{StaticResource Campo}" ItemsSource="{Binding Monedas}" SelectedItem="{Binding Moneda}" IsEnabled="{Binding PuedeEditarFinanciero}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Monto original" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding MontoOriginal, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" IsEnabled="{Binding PuedeEditarFinanciero}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Total cuotas *" Style="{StaticResource Etiqueta}"/>
                            <TextBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding TotalCuotas, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeEditarFinanciero}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="3">
                            <TextBlock Text="Total cronograma" Style="{StaticResource Etiqueta}"/>
                            <TextBlock Height="32" Text="{Binding TotalCronogramaTexto}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Cronograma de cuotas" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Generar" Style="{StaticResource Boton}" Command="{Binding GenerarCuotasCommand}" IsEnabled="{Binding PuedeGenerarCronograma}" Margin="0,0,8,0"/>
                                <Button Content="Agregar cuota" Style="{StaticResource Boton}" Command="{Binding AgregarCuotaCommand}" IsEnabled="{Binding PuedeAgregarQuitarCuotas}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Cuotas}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  RowHeight="38"
                                  MinHeight="260"
                                  MaxHeight="430"
                                  Background="#F8FAFC"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Accion" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="27" ToolTip="Quitar cuota"
                                                    Command="{Binding DataContext.QuitarCuotaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding PuedeQuitar}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cuota" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CeldaTexto}" Text="{Binding NumeroCuota, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeEditarNumeroImporte}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalCuotas}" Width="80" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Vencimiento" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding FechaVencimiento}" IsEnabled="{Binding DataContext.PuedeEditarCronograma, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Importe" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CeldaTexto}" Text="{Binding Importe, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" IsEnabled="{Binding PuedeEditarNumeroImporte}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Observacion" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CeldaTexto}" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Observacion general" Style="{StaticResource Etiqueta}"/>
                        <TextBox Height="72" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Style="{StaticResource Boton}" Command="{Binding CancelarCommand}" Margin="0,0,10,0"/>
            <Button Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                    <TextBlock Text="Guardar"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
