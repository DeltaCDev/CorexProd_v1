<UserControl x:Class="CorexProd.WPF.Modules.Tesoreria.Views.PrestamosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Icono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CampoCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Celda" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="EstadoBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="PARCIAL">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                    <Setter Property="Background" Value="#DCFCE7"/>
                    <Setter Property="BorderBrush" Value="#22C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstadoTexto" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="PARCIAL">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Foreground" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PRESTAMOS" FontSize="21" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Resumen}" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BotonPrimario}" Command="{Binding NuevaCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                            <TextBlock Text="Nuevo Prestamo"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Boton}" Command="{Binding ActualizarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Buscar" Style="{StaticResource Etiqueta}"/>
                        <TextBox Width="260" Style="{StaticResource CampoTexto}" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Entidad" Style="{StaticResource Etiqueta}"/>
                        <ComboBox Width="220" Style="{StaticResource CampoCombo}" ItemsSource="{Binding Entidades}" DisplayMemberPath="Nombre" SelectedItem="{Binding EntidadFiltro}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                        <ComboBox Width="145" Style="{StaticResource CampoCombo}" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoFiltro}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Moneda" Style="{StaticResource Etiqueta}"/>
                        <ComboBox Width="110" Style="{StaticResource CampoCombo}" ItemsSource="{Binding Monedas}" SelectedItem="{Binding MonedaFiltro}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Prestamos}"
                  SelectedItem="{Binding PrestamoSeleccionado}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="42"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Acciones" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BotonAccion}" ToolTip="Ver detalle" Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE890;" Style="{StaticResource Icono}" Foreground="#475569"/>
                                </Button>
                                <Button Style="{StaticResource BotonAccion}" ToolTip="Editar" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icono}" Foreground="#2563EB"/>
                                </Button>
                                <Button Style="{StaticResource BotonAccion}" ToolTip="Anular" Command="{Binding DataContext.AnularCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icono}" Foreground="#DC2626"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy}" Width="95" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Entidad" Binding="{Binding EntidadFinanciera}" Width="175" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Titular" Binding="{Binding NombreTitular}" Width="190" ElementStyle="{StaticResource Celda}"/>
                <DataGridTemplateColumn Header="Estado" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EstadoBadge}">
                                <TextBlock Text="{Binding Estado}" Style="{StaticResource EstadoTexto}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="190" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Mon." Binding="{Binding Moneda}" Width="62" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding MontoOriginal, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Cronograma" Binding="{Binding TotalCronograma, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Prox. Venc." Binding="{Binding ProximoVencimiento, StringFormat=dd/MM/yyyy}" Width="105" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Operacion" Binding="{Binding NumeroOperacion}" Width="120" ElementStyle="{StaticResource Celda}"/>
                <DataGridTextColumn Header="Obs." Binding="{Binding Observacion}" Width="*" ElementStyle="{StaticResource Celda}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
