<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.PrestamoDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Prestamo"
        Width="1180"
        Height="760"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>
        <Style x:Key="Celda" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TituloTextBlock" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <Border x:Name="EstadoBorder" CornerRadius="12" Padding="12,5" Margin="12,0,0,0">
                        <TextBlock x:Name="EstadoTextBlock" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtituloTextBlock" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RegistrarPagoButton" Content="Registrar pago" Style="{StaticResource BotonPrimario}" Click="RegistrarPago_Click" Margin="0,0,8,0"/>
                <Button x:Name="EditarButton" Content="Editar" Style="{StaticResource Boton}" Click="Editar_Click" Margin="0,0,8,0"/>
                <Button x:Name="AnularPrestamoButton" Content="Anular prestamo" Style="{StaticResource BotonPeligro}" Click="AnularPrestamo_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="ENTIDAD" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="EntidadTextBlock" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="TITULAR" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="TitularTextBlock" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="MONEDA / MONTO" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="MontoTextBlock" Style="{StaticResource Valor}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,14,0">
                            <TextBlock Text="PAGADO" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="PagadoTextBlock" Style="{StaticResource Valor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SALDO" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="SaldoTextBlock" Style="{StaticResource Valor}" FontWeight="Bold" Foreground="#B45309"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CRONOGRAMA" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>
                        <DataGrid x:Name="CuotasDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowHeight="38"
                                  MinHeight="190"
                                  MaxHeight="310"
                                  SelectionMode="Single"
                                  Background="#F8FAFC"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cuota" Binding="{Binding NumeroCuota}" Width="80" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalCuotas}" Width="80" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="120" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Observacion" Binding="{Binding Observacion}" Width="*" ElementStyle="{StaticResource Celda}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="HISTORIAL DE PAGOS" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid x:Name="PagosDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeight="38"
                                      MinHeight="155"
                                      MaxHeight="260"
                                      Background="#F8FAFC"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Accion" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="30" Height="27" ToolTip="Anular pago" Click="AnularPago_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="ANULADO">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="105" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Cuota" Binding="{Binding NumeroCuota}" Width="80" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Banco" Binding="{Binding Banco}" Width="180" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Cuenta" Binding="{Binding NumeroCuenta}" Width="160" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="N. Operacion" Binding="{Binding NumeroOperacion}" Width="130" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioRegistro}" Width="160" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Usuario anulacion" Binding="{Binding UsuarioAnulacion}" Width="160" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Fecha anulacion" Binding="{Binding FechaAnulacion, StringFormat=dd/MM/yyyy HH:mm}" Width="145" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Motivo anulacion" Binding="{Binding MotivoAnulacion}" Width="220" ElementStyle="{StaticResource Celda}"/>
                                    <DataGridTextColumn Header="Observacion" Binding="{Binding Observacion}" Width="220" ElementStyle="{StaticResource Celda}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HISTORIAL" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>
                        <DataGrid x:Name="HistorialDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowHeight="36"
                                  MinHeight="145"
                                  MaxHeight="240"
                                  Background="#F8FAFC"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="145" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Accion" Binding="{Binding Accion}" Width="140" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Estado anterior" Binding="{Binding EstadoAnterior}" Width="130" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Estado nuevo" Binding="{Binding EstadoNuevo}" Width="130" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="170" ElementStyle="{StaticResource Celda}"/>
                                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource Celda}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar" Style="{StaticResource Boton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
