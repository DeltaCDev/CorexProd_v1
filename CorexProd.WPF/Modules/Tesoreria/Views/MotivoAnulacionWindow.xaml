<Window x:Class="CorexProd.WPF.Modules.Tesoreria.Views.MotivoAnulacionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="460" Height="290" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TituloTextBlock" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="DescripcionTextBlock" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16"><TextBlock Text="Motivo *" FontWeight="SemiBold"/><TextBox x:Name="MotivoTextBox" Height="90" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"/><TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" Visibility="Collapsed" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/><Button Content="Confirmar" Click="Confirmar_Click" Padding="14,6" Background="#BE123C" Foreground="White"/></StackPanel>
    </Grid>
</Window>
