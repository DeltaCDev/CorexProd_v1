<UserControl x:Class="CorexProd.WPF.Modules.Reportes.Views.StockProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="CampoCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,16">
                    <TextBlock Text="Consulta de codigo, producto, etiqueta, stock fisico, reservado y disponible real."
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,10,16">
                    <StackPanel>
                        <TextBlock Text="Productos"
                                   Foreground="#1D4ED8"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TotalProductos}"
                                   Foreground="#1E3A8A"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Disponible total"
                                   Foreground="#047857"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CantidadTotal, StringFormat=N2}"
                                   Foreground="#065F46"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Buscar por codigo o nombre"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Etiqueta / Cliente"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding EtiquetaBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Categoria"
                                   Style="{StaticResource LabelCampo}"/>
                        <ComboBox Style="{StaticResource CampoCombo}"
                                  ItemsSource="{Binding Categorias}"
                                  DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="IdCategoriaProducto"
                                  SelectedValue="{Binding IdCategoriaSeleccionada}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Buscar"
                                Width="95"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding BuscarCommand}"/>
                        <Button Content="Limpiar"
                                Width="95"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding LimpiarCommand}"/>
                        <Button Content="Actualizar"
                                Width="95"
                                Height="32"
                                Command="{Binding ActualizarCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding StockProductos}"
                      SelectedItem="{Binding StockProductoSeleccionado, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODIGO"
                                        Binding="{Binding Codigo}"
                                        Width="130"/>
                    <DataGridTextColumn Header="NOMBRE DE PRODUCTO"
                                        Binding="{Binding NombreProducto}"
                                        Width="*"/>
                    <DataGridTextColumn Header="ETIQUETA / CLIENTE"
                                        Binding="{Binding EtiquetaCliente}"
                                        Width="170"/>
                    <DataGridTextColumn Header="CATEGORIA"
                                        Binding="{Binding NombreCategoria}"
                                        Width="160"/>
                    <DataGridTextColumn Header="ALMACEN"
                                        Binding="{Binding NombreAlmacen}"
                                        Width="150"/>
                    <DataGridTextColumn Header="FISICO"
                                        Binding="{Binding StockFisico, StringFormat=N2}"
                                        Width="105"/>
                    <DataGridTextColumn Header="RESERVADO"
                                        Binding="{Binding StockReservado, StringFormat=N2}"
                                        Width="110"/>
                    <DataGridTextColumn Header="DISPONIBLE"
                                        Binding="{Binding StockDisponible, StringFormat=N2}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,12,0,0"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Historial de reservas"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#111827"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding ResumenHistorial}"
                               Foreground="#6B7280"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistorialReservas}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="36"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA"
                                            Binding="{Binding FechaMovimiento, StringFormat=dd/MM/yyyy HH:mm}"
                                            Width="125"/>
                        <DataGridTextColumn Header="MOVIMIENTO"
                                            Binding="{Binding TipoMovimiento}"
                                            Width="110"/>
                        <DataGridTextColumn Header="CANTIDAD"
                                            Binding="{Binding CantidadMovimiento, StringFormat=N2}"
                                            Width="95"/>
                        <DataGridTextColumn Header="OCI"
                                            Binding="{Binding NumeroOci}"
                                            Width="105"/>
                        <DataGridTextColumn Header="OT"
                                            Binding="{Binding NumeroOT}"
                                            Width="105"/>
                        <DataGridTextColumn Header="DOCUMENTO"
                                            Binding="{Binding DocumentoReferencia}"
                                            Width="120"/>
                        <DataGridTextColumn Header="USUARIO"
                                            Binding="{Binding UsuarioMovimiento}"
                                            Width="120"/>
                        <DataGridTextColumn Header="OBSERVACION"
                                            Binding="{Binding ObservacionMovimiento}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
