<UserControl x:Class="CorexProd.WPF.Modules.Reportes.Views.StockProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="CampoCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,16">
                    <TextBlock Text="Stock de Productos"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Consulta de codigo, producto, etiqueta, stock fisico, reservado y disponible real."
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,10,16">
                    <StackPanel>
                        <TextBlock Text="Productos"
                                   Foreground="#1D4ED8"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TotalProductos}"
                                   Foreground="#1E3A8A"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Disponible total"
                                   Foreground="#047857"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CantidadTotal, StringFormat=N2}"
                                   Foreground="#065F46"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Buscar por codigo o nombre"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Etiqueta / Cliente"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding EtiquetaBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Categoria"
                                   Style="{StaticResource LabelCampo}"/>
                        <ComboBox Style="{StaticResource CampoCombo}"
                                  ItemsSource="{Binding Categorias}"
                                  DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="IdCategoriaProducto"
                                  SelectedValue="{Binding IdCategoriaSeleccionada}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Buscar"
                                Width="95"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding BuscarCommand}"/>
                        <Button Content="Limpiar"
                                Width="95"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding LimpiarCommand}"/>
                        <Button Content="Actualizar"
                                Width="95"
                                Height="32"
                                Command="{Binding ActualizarCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding StockProductos}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODIGO"
                                        Binding="{Binding Codigo}"
                                        Width="95"/>
                    <DataGridTextColumn Header="PRODUCTO"
                                        Binding="{Binding NombreProducto}"
                                        Width="500"/>
                    <DataGridTextColumn Binding="{Binding StockFisico, StringFormat=N2}"
                                        Width="80">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="STOCK&#10;FISICO"
                                       TextAlignment="Center"
                                       LineHeight="15"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="RESERVA"
                                            Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="VerReservas_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        ToolTip="Ver stock de reservas filtrado por producto">
                                    <TextBlock Text="{Binding StockReservado, StringFormat=N2}"
                                               TextAlignment="Center"
                                               TextDecorations="Underline"
                                               Foreground="#1D4ED8"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DISPONIBLE"
                                        Binding="{Binding StockDisponible, StringFormat=N2}"
                                        Width="90"/>
                    <DataGridTextColumn Binding="{Binding EtiquetaCliente}"
                                        Width="140">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="ETIQUETA /&#10;CLIENTE"
                                       TextAlignment="Center"
                                       LineHeight="15"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CATEGORIA"
                                        Binding="{Binding NombreCategoria}"
                                        Width="160"/>
                    <DataGridTextColumn Header="ALMACEN"
                                        Binding="{Binding NombreAlmacen}"
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
