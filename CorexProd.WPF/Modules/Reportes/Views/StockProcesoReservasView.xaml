<UserControl x:Class="CorexProd.WPF.Modules.Reportes.Views.StockProcesoReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="EstadoReservaBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#DCFCE7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="APLICADO">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="ToolTip" Value="Ya está usado."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoReservaTexto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#166534"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="APLICADO">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,16">
                    <TextBlock Text="Stock de Reservas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Lista de productos reservados en proceso por producto, area y orden de trabajo."
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,10,16">
                    <StackPanel>
                        <TextBlock Text="Productos reservados"
                                   Foreground="#1D4ED8"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TotalProductosReservados}"
                                   Foreground="#1E3A8A"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Cantidad reservada"
                                   Foreground="#047857"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CantidadTotal, StringFormat=N2}"
                                   Foreground="#065F46"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="3"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,10,16">
                    <StackPanel>
                        <TextBlock Text="Cantidad usada"
                                   Foreground="#B91C1C"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CantidadUsadaTotal, StringFormat=N2}"
                                   Foreground="#991B1B"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="4"
                        Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Cantidad disponible"
                                   Foreground="#15803D"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CantidadDisponibleTotal, StringFormat=N2}"
                                   Foreground="#166534"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Buscar por codigo, producto u OT"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Area"
                                   Style="{StaticResource LabelCampo}"/>
                        <TextBox Style="{StaticResource CampoTexto}"
                                 Text="{Binding AreaBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Fecha desde"
                                   Style="{StaticResource LabelCampo}"/>
                        <DatePicker Width="130"
                                    Height="32"
                                    SelectedDate="{Binding FechaDesde}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="Fecha hasta"
                                   Style="{StaticResource LabelCampo}"/>
                        <DatePicker Width="130"
                                    Height="32"
                                    SelectedDate="{Binding FechaHasta}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Buscar"
                                Width="95"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding BuscarCommand}"/>
                        <Button Content="Quitar filtros"
                                Width="110"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding LimpiarCommand}"/>
                        <Button Content="Actualizar"
                                Width="95"
                                Height="32"
                                Command="{Binding ActualizarCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Reservas}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODIGO"
                                        Binding="{Binding CodigoProducto}"
                                        Width="85"/>
                    <DataGridTextColumn Header="PRODUCTO"
                                        Binding="{Binding NombreProducto}"
                                        Width="400"/>
                    <DataGridTextColumn Header="AREA"
                                        Binding="{Binding NombreArea}"
                                        Width="120"/>
                    <DataGridTextColumn Header="OT ORIGEN"
                                        Binding="{Binding NumeroOT}"
                                        Width="90"/>
                    <DataGridTextColumn Binding="{Binding CantidadReservada, StringFormat=N2}"
                                        Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="CANTIDAD&#10;RESERVADA"
                                       TextAlignment="Center"
                                       LineHeight="15"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CantidadAplicada, StringFormat=N2}"
                                        Width="85">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="CANTIDAD&#10;USADA"
                                       TextAlignment="Center"
                                       LineHeight="15"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CantidadDisponible, StringFormat=N2}"
                                        Width="89">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="CANTIDAD&#10;DISPONIBLE"
                                       TextAlignment="Center"
                                       LineHeight="15"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="ESTADO"
                                            Width="117">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EstadoReservaBadge}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Estado}"
                                               Style="{StaticResource EstadoReservaTexto}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="FECHA"
                                        Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
