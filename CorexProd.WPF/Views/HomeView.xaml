<UserControl x:Class="CorexProd.WPF.Views.HomeView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <DataTemplate x:Key="ResumenItemTemplate">
            <Border Background="#F8FAFC" CornerRadius="9" Padding="12" Margin="0,0,9,9">
                <StackPanel>
                    <TextBlock Text="{Binding Valor}" FontSize="23" FontWeight="Bold" Foreground="{Binding Color}"/>
                    <TextBlock Text="{Binding Titulo}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KpiTemplate">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Valor}" FontSize="27" FontWeight="Bold" Foreground="{Binding Color}"/>
                        <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        <TextBlock Text="Datos reales del periodo" FontSize="10" Foreground="#64748B" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" VerticalAlignment="Top">
                        <TextBlock Text="◉" FontSize="20" Foreground="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankingTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="21" Height="21" CornerRadius="10" Background="#EFF6FF">
                    <TextBlock Text="{Binding Posicion}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Cantidad}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BarraTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Mes}" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="9" VerticalAlignment="Center">
                    <Border Background="#E2E8F0" CornerRadius="5"/>
                    <Border Width="{Binding Ancho}" Background="{Binding Color}" CornerRadius="5" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panel principal" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Resumen operativo con información real del sistema" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="44" Height="44" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" ToolTip="Notificaciones de entregas">
                        <TextBlock Text="🔔" FontSize="20"/>
                    </Button>
                    <Border Width="1" Height="38" Background="#E2E8F0" Margin="16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Panel operativo" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Información actualizada" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">
                <Border Background="#0F172A" CornerRadius="14" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DASHBOARD OPERATIVO" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                            <TextBlock Text="{Binding EmpresaTitulo}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ResumenInicio}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="10" Padding="16,11" VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PERIODO" FontSize="9" FontWeight="Bold" Foreground="#C2410C"/>
                                <TextBlock Text="{Binding PeriodoActual}" FontSize="13" FontWeight="SemiBold" Foreground="#7C2D12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding IndicadoresGenerales}" ItemTemplate="{StaticResource KpiTemplate}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Órdenes de Compra" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Estados del mes actual y clientes con más órdenes." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                            <ItemsControl ItemsSource="{Binding OrdenesCompraResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Top 5 clientes con más OC" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,9"/>
                            <ItemsControl ItemsSource="{Binding TopClientes}" ItemTemplate="{StaticResource RankingTemplate}"/>
                            <TextBlock Text="Últimos 6 meses" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,9"/>
                            <ItemsControl ItemsSource="{Binding EstadisticaOc6Meses}" ItemTemplate="{StaticResource BarraTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Órdenes de Trabajo" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Producción del mes, tipos de OT y productos elaborados." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                            <ItemsControl ItemsSource="{Binding OrdenesTrabajoResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Top 5 productos más elaborados" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,9"/>
                            <ItemsControl ItemsSource="{Binding TopProductos}" ItemTemplate="{StaticResource RankingTemplate}"/>
                            <TextBlock Text="Últimos 6 meses" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,9"/>
                            <ItemsControl ItemsSource="{Binding EstadisticaOt6Meses}" ItemTemplate="{StaticResource BarraTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#F97316" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Seguimiento operativo" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="OC pendientes, en producción y entregadas." FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#FFF7ED">
                                    <TextBlock Text="🔔" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Resumen de Órdenes de Compra" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,10"/>
                            <ItemsControl ItemsSource="{Binding OrdenesCompraResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Estado de los datos" FontSize="11" FontWeight="Bold" Foreground="#9A3412"/>
                                    <TextBlock Text="{Binding MensajeDatos}" FontSize="11" Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Productividad del mes" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,10"/>
                            <Border Background="#F8FAFC" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="Usuario con más OC" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding UsuarioMasOc.Nombre}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding UsuarioMasOc.CantidadTexto}" FontSize="10" Foreground="#2563EB" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="9" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Usuario con más OT" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding UsuarioMasOt.Nombre}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding UsuarioMasOt.CantidadTexto}" FontSize="10" Foreground="#16A34A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Guías internas de salida" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Movimiento interno generado durante el mes." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                        <ItemsControl ItemsSource="{Binding GuiasResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>