<UserControl x:Class="CorexProd.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <DataTemplate x:Key="ResumenItemTemplate">
            <Border Background="#F8FAFC" CornerRadius="9" Padding="12" Margin="0,0,9,9">
                <StackPanel>
                    <TextBlock Text="{Binding Valor}" FontSize="23" FontWeight="Bold" Foreground="{Binding Color}"/>
                    <TextBlock Text="{Binding Titulo}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KpiTemplate">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Valor}" FontSize="27" FontWeight="Bold" Foreground="{Binding Color}"/>
                        <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        <TextBlock Text="Datos reales del periodo" FontSize="10" Foreground="#64748B" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" VerticalAlignment="Top">
                        <TextBlock Text="◉" FontSize="20" Foreground="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankingTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="21" Height="21" CornerRadius="10" Background="#EFF6FF">
                    <TextBlock Text="{Binding Posicion}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Cantidad}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AlertaTemplate">
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <StackPanel Grid.Column="1" Margin="8,0,10,0">
                        <TextBlock Text="{Binding NumeroOci}" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding NombreCliente}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FechaEntrega, StringFormat=Entrega: {0:dd/MM/yyyy}}" FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding AlertaTexto}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Ver OC" Padding="10,4" VerticalAlignment="Center" Click="VerOcAlerta_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panel principal" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Resumen operativo con información real del sistema" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="CampanaButton" Width="46" Height="46" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" ToolTip="Notificaciones de entrega" Click="Campana_Click">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#DC2626" CornerRadius="9" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0">
                                <TextBlock Text="{Binding CantidadAlertasEntrega}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Popup x:Name="NotificacionesPopup" PlacementTarget="{Binding ElementName=CampanaButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="390" MaxHeight="520" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Border.Effect><DropShadowEffect BlurRadius="18" Opacity="0.22" ShadowDepth="4"/></Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Notificaciones de entrega" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CantidadAlertasEntrega, StringFormat={}{0} alertas}" Foreground="#DC2626" FontWeight="SemiBold"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                                    <ItemsControl ItemsSource="{Binding AlertasEntrega}" ItemTemplate="{StaticResource AlertaTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">
                <Border Background="#0F172A" CornerRadius="14" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DASHBOARD OPERATIVO" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                            <TextBlock Text="{Binding EmpresaTitulo}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ResumenInicio}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="10" Padding="16,11" VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PERIODO" FontSize="9" FontWeight="Bold" Foreground="#C2410C"/>
                                <TextBlock Text="{Binding PeriodoActual}" FontSize="13" FontWeight="SemiBold" Foreground="#7C2D12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding IndicadoresGenerales}" ItemTemplate="{StaticResource KpiTemplate}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Órdenes de Compra" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Estados del mes actual y clientes con más órdenes." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                            <ItemsControl ItemsSource="{Binding OrdenesCompraResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Top 5 clientes con más OC" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,9"/>
                            <ItemsControl ItemsSource="{Binding TopClientes}" ItemTemplate="{StaticResource RankingTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Órdenes de Trabajo" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Producción del mes, tipos de OT y productos elaborados." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                            <ItemsControl ItemsSource="{Binding OrdenesTrabajoResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Top 5 productos más elaborados" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,9"/>
                            <ItemsControl ItemsSource="{Binding TopProductos}" ItemTemplate="{StaticResource RankingTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#F97316" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Seguimiento de fechas de entrega" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="OC activas próximas a vencer o vencidas." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>

                            <UniformGrid Columns="2">
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="10" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Vencidas}" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/><TextBlock Text="Vencidas" FontSize="10"/></StackPanel></Border>
                                <Border Background="#FFF7ED" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding VencenHoy}" FontSize="22" FontWeight="Bold" Foreground="#F97316"/><TextBlock Text="Vencen hoy" FontSize="10"/></StackPanel></Border>
                                <Border Background="#FEFCE8" CornerRadius="8" Padding="10" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding ProximasVencer}" FontSize="22" FontWeight="Bold" Foreground="#CA8A04"/><TextBlock Text="Próximas (1-3 días)" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DentroPlazoCercano}" FontSize="22" FontWeight="Bold" Foreground="#0284C7"/><TextBlock Text="Dentro de 4-7 días" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
                            </UniformGrid>

                            <Border Background="#F0FDF4" CornerRadius="8" Padding="10" Margin="0,2,0,12">
                                <Grid><TextBlock Text="Entregadas a tiempo" Foreground="#166534"/><TextBlock Text="{Binding EntregadasATiempo}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="#16A34A"/></Grid>
                            </Border>

                            <TextBlock Text="Órdenes más urgentes" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AlertasUrgentes}" ItemTemplate="{StaticResource AlertaTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Guías internas de salida" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Movimiento interno generado durante el mes." FontSize="11" Foreground="#64748B" Margin="0,4,0,13"/>
                        <ItemsControl ItemsSource="{Binding GuiasResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MensajeDatos}" FontSize="11" Foreground="#7C2D12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
