<UserControl x:Class="CorexProd.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#1F3A5F"
                          Opacity="0.08"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#DCE3EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#EEF4FF"/>
                                <Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="#93B4F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#DDE9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F1D3A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="MetricRowTemplate">
            <Border Background="#FFFFFF"
                    BorderBrush="#E7ECF4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6"
                    Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icono}"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{Binding Color}"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Titulo}"
                               FontSize="10.5"
                               Foreground="#263451"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Valor}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#0F1D3A"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankingTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="19"
                        Height="19"
                        CornerRadius="10"
                        Background="#EEF3FF"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Posicion}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Nombre}"
                           FontSize="10.5"
                           Foreground="#33415F"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Cantidad}"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#0F1D3A"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BarTemplate">
            <Grid Height="112" Margin="3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Total}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#33415F"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>
                <Grid Grid.Row="1">
                    <Border Width="30"
                            Height="{Binding Ancho}"
                            MaxHeight="76"
                            Background="{Binding Color}"
                            CornerRadius="3,3,0,0"
                            Opacity="0.82"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Grid.Row="2"
                           Text="{Binding Mes}"
                           FontSize="8.5"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F6F8FC">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,18,18">

                <!-- Cabecera -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#0F1D3A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding FechaDashboard}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#536382"
                                       VerticalAlignment="Center"/>
                            <Border Width="1"
                                    Height="16"
                                    Background="#D5DCE7"
                                    Margin="20,0"/>
                            <TextBlock Text="👋  ¡Bienvenido de vuelta, "
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#536382"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.NombreUsuario, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#315CA8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="!"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#536382"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 1. Campana -->
                        <Grid Margin="0,0,8,0">
                            <Button x:Name="CampanaButton"
                                    Style="{StaticResource HeaderIconButton}"
                                    Click="Campana_Click"
                                    ToolTip="Notificaciones">
                                <TextBlock Text="&#xE7F4;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="#1747A6"/>
                            </Button>
                            <Border Background="#E53945"
                                    CornerRadius="9"
                                    Padding="5,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-3,-4,0">
                                <TextBlock Text="{Binding CantidadAlertasEntrega}"
                                           Foreground="White"
                                           FontSize="8.5"
                                           FontWeight="Bold"/>
                            </Border>

                            <Popup x:Name="NotificacionesPopup"
                                   PlacementTarget="{Binding ElementName=CampanaButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="340"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Notificaciones de entrega"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,10"/>
                                        <Border Background="#FFF0F0" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <TextBlock Text="Vencidas" Foreground="#334155"/>
                                                <TextBlock Text="{Binding Vencidas}" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="#FFF4E8" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <TextBlock Text="Vencen hoy" Foreground="#334155"/>
                                                <TextBlock Text="{Binding VencenHoy}" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="#FFF8DE" CornerRadius="7" Padding="10,7">
                                            <Grid>
                                                <TextBlock Text="Próximas (1-3 días)" Foreground="#334155"/>
                                                <TextBlock Text="{Binding ProximasVencer}" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 2. Cerrar sesión -->
                        <Button Style="{StaticResource HeaderIconButton}"
                                Command="{Binding DataContext.CerrarSesionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Cerrar sesión"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE8AC;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#DC2626"/>
                        </Button>

                        <!-- 3. Usuario logueado; sin repetir avatar ni rol de la barra lateral -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#1747A6"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding DataContext.NombreUsuario, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0F1D3A"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Indicadores reales -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Height="108" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="11" Background="#EEF4FF" VerticalAlignment="Top">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="OCI generadas" FontSize="11" FontWeight="Bold" Foreground="#0F1D3A"/>
                                <TextBlock Text="{Binding OrdenesCompraResumen[0].Valor}" FontSize="27" FontWeight="Bold" Foreground="#0F1D3A" Margin="0,3,0,0"/>
                                <TextBlock Text="Este mes" FontSize="10" Foreground="#52627F"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Height="108" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="11" Background="#EAF8EF" VerticalAlignment="Top">
                                <TextBlock Text="&#xE99B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="OT en proceso" FontSize="11" FontWeight="Bold" Foreground="#0F1D3A"/>
                                <TextBlock Text="{Binding OrdenesTrabajoResumen[1].Valor}" FontSize="27" FontWeight="Bold" Foreground="#0F1D3A" Margin="0,3,0,0"/>
                                <TextBlock Text="Actualmente" FontSize="10" Foreground="#52627F"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Height="108">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="11" Background="#FFF1E7" VerticalAlignment="Top">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Productos con stock bajo" FontSize="11" FontWeight="Bold" Foreground="#0F1D3A" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StockCritico, StringFormat={}{0:N0}}" FontSize="27" FontWeight="Bold" Foreground="#0F1D3A" Margin="0,3,0,0"/>
                                <TextBlock Text="Atención requerida" FontSize="10" Foreground="#52627F"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Resúmenes operativos -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.12*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#2563EB" Margin="0,0,8,0"/>
                                    <TextBlock Text="Órdenes de Compra" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ver detalle" Style="{StaticResource LinkButton}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OrdenesCompraResumen}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE99B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#16A34A" Margin="0,0,8,0"/>
                                    <TextBlock Text="Órdenes de Trabajo" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ver detalle" Style="{StaticResource LinkButton}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OrdenesTrabajoResumen}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#2563EB" Margin="0,0,8,0"/>
                                    <TextBlock Text="Seguimiento de fechas de entrega" FontSize="12.5" FontWeight="Bold" Foreground="#0F1D3A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ver todas" Style="{StaticResource LinkButton}" Click="Campana_Click"/>
                            </Grid>

                            <Border Background="#FFF0F0" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="●   Vencidas" Foreground="#25334F" FontSize="10.5"/><TextBlock Text="{Binding Vencidas}" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#FFF4E8" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="●   Vencen hoy" Foreground="#25334F" FontSize="10.5"/><TextBlock Text="{Binding VencenHoy}" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#FFF8DE" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="●   Próximas (1-3 días)" Foreground="#25334F" FontSize="10.5"/><TextBlock Text="{Binding ProximasVencer}" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#EEF4FF" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="●   Dentro de 4-7 días" Foreground="#25334F" FontSize="10.5"/><TextBlock Text="{Binding DentroPlazoCercano}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#EAF8EF" CornerRadius="6" Padding="10,6">
                                <Grid><TextBlock Text="●   Más de 7 días" Foreground="#25334F" FontSize="10.5"/><TextBlock Text="{Binding EntregadasATiempo}" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Estadísticas reales de los últimos 6 meses -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="OCI últimos 6 meses" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Ver reporte" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EstadisticaOc6Meses}" ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="OT últimos 6 meses" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Ver reporte" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EstadisticaOt6Meses}" ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rankings reales -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Top 5 Clientes (por OC)" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Ver reporte" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TopClientes}" ItemTemplate="{StaticResource RankingTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Top 5 Productos (por OT)" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Ver reporte" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TopProductos}" ItemTemplate="{StaticResource RankingTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Información real, sin datos de ejemplo -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Usuarios destacados del mes" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Border Background="#F5F8FF" CornerRadius="7" Padding="10,8" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mayor generación de OC" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding UsuarioMasOc.Nombre}" FontSize="11.5" FontWeight="Bold" Foreground="#0F1D3A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsuarioMasOc.CantidadTexto}" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="#F1FBF5" CornerRadius="7" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mayor generación de OT" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding UsuarioMasOt.Nombre}" FontSize="11.5" FontWeight="Bold" Foreground="#0F1D3A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsuarioMasOt.CantidadTexto}" FontSize="10.5" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding UltimaActualizacion}" FontSize="9.5" Foreground="#64748B" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alertas importantes" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Border Background="#FFF0F0" CornerRadius="7" Padding="9,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="Órdenes de compra vencidas"/><TextBlock Text="{Binding Vencidas}" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#FFF4E8" CornerRadius="7" Padding="9,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="Productos con stock mínimo"/><TextBlock Text="{Binding StockCritico}" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#FFF8DE" CornerRadius="7" Padding="9,6" Margin="0,0,0,6">
                                <Grid><TextBlock Text="OC próximas a vencer"/><TextBlock Text="{Binding CantidadAlertasEntrega}" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#EEF4FF" CornerRadius="7" Padding="9,6">
                                <Grid><TextBlock Text="OT anuladas este mes"/><TextBlock Text="{Binding OtAnuladasMes}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Resumen rápido -->
                <Border Style="{StaticResource Card}" BorderBrush="#BED3FF" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#DCE8FF" Margin="0,0,10,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Resumen rápido" FontSize="12" FontWeight="Bold" Foreground="#0F1D3A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CantidadAlertasEntrega}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                            <TextBlock Text="OC próximas a vencer" FontSize="10" Foreground="#52627F"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OtAnuladasMes}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                            <TextBlock Text="OT anuladas" FontSize="10" Foreground="#52627F"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StockCritico}" FontSize="18" FontWeight="Bold" Foreground="#F97316" HorizontalAlignment="Center"/>
                            <TextBlock Text="Productos con stock mínimo" FontSize="10" Foreground="#52627F"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
