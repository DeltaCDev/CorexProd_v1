<UserControl x:Class="CorexProd.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>

        <DataTemplate x:Key="ResumenItemTemplate">
            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding Valor}" FontSize="24" FontWeight="Bold" Foreground="{Binding Color}"/>
                    <TextBlock Text="{Binding Titulo}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankingTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="21" Height="21" CornerRadius="10" Background="#EFF6FF">
                    <TextBlock Text="{Binding Posicion}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Cantidad}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BarraTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Mes}" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="11" VerticalAlignment="Center">
                    <Border Background="#E2E8F0" CornerRadius="6"/>
                    <Border Width="{Binding Ancho}" Background="{Binding Color}" CornerRadius="6" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Background="#F8FAFC" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Background="#0F172A" CornerRadius="14" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DASHBOARD OPERATIVO" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                        <TextBlock Text="{Binding EmpresaTitulo}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ResumenInicio}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="10" Padding="14,10" VerticalAlignment="Center" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="PERIODO" FontSize="10" FontWeight="Bold" Foreground="#C2410C"/>
                            <TextBlock Text="{Binding PeriodoActual}" FontSize="13" FontWeight="SemiBold" Foreground="#7C2D12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding IndicadoresGenerales}" ItemTemplate="{StaticResource ResumenItemTemplate}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Órdenes de Compra" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Estados del mes actual y clientes con más órdenes." FontSize="12" Foreground="#64748B" Margin="0,4,0,14"/>

                        <ItemsControl ItemsSource="{Binding OrdenesCompraResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Top 5 clientes con más OC" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,10"/>
                        <ItemsControl ItemsSource="{Binding TopClientes}" ItemTemplate="{StaticResource RankingTemplate}"/>

                        <TextBlock Text="Últimos 6 meses" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding EstadisticaOc6Meses}" ItemTemplate="{StaticResource BarraTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Órdenes de Trabajo" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Producción del mes, tipos de OT y productos más elaborados." FontSize="12" Foreground="#64748B" Margin="0,4,0,14"/>

                        <ItemsControl ItemsSource="{Binding OrdenesTrabajoResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Top 5 productos más elaborados" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,10"/>
                        <ItemsControl ItemsSource="{Binding TopProductos}" ItemTemplate="{StaticResource RankingTemplate}"/>

                        <TextBlock Text="Últimos 6 meses" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding EstadisticaOt6Meses}" ItemTemplate="{StaticResource BarraTemplate}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Guías internas de salida" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Movimiento interno generado durante el mes." FontSize="12" Foreground="#64748B" Margin="0,4,0,14"/>
                        <ItemsControl ItemsSource="{Binding GuiasResumen}" ItemTemplate="{StaticResource ResumenItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Últimos 6 meses" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,10"/>
                        <ItemsControl ItemsSource="{Binding EstadisticaGuias6Meses}" ItemTemplate="{StaticResource BarraTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Productividad de usuarios" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Usuarios con mayor generación de documentos este mes." FontSize="12" Foreground="#64748B" Margin="0,4,0,14"/>

                        <Border Background="#F8FAFC" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Usuario con más Órdenes de Compra" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding UsuarioMasOc.Nombre}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding UsuarioMasOc.CantidadTexto}" FontSize="12" Foreground="#2563EB" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Usuario con más Órdenes de Trabajo" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding UsuarioMasOt.Nombre}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding UsuarioMasOt.CantidadTexto}" FontSize="12" Foreground="#16A34A" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,16,0,0">
                            <TextBlock Text="{Binding MensajeDatos}" FontSize="12" Foreground="#7C2D12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
