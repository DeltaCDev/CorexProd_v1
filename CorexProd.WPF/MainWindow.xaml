<Window x:Class="CorexProd.WPF.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CorexProd.WPF.Helpers"
        Title="CorexProd"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="#F3F4F6">

    <Window.Resources>
        <helpers:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>

        <Style x:Key="MenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="20,2,8,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SubMenuBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubMenuBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SubMenuBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapsedMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CollapsedBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CollapsedBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="CollapsedBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CollapsedBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapsedContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CollapsedContextMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Header" Value="{Binding Titulo}"/>
            <Setter Property="Command" Value="{Binding PlacementTarget.Tag.IrVistaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Setter Property="CommandParameter" Value="{Binding Vista}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <DataTemplate x:Key="SidebarModuleHeaderTemplate">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Icono}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{Binding ColorIcono}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Titulo}"
                           Foreground="#111827"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding DataContext.SidebarWidth, ElementName=RootWindow}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top">
                    <StackPanel Visibility="{Binding SidebarExpandedVisibility}">
                        <Grid Margin="10,10,10,6" Height="66">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="154"
                                    Height="62"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="7"
                                    BorderBrush="#F97316"
                                    BorderThickness="2">
                                <Image Source="{Binding LogoMenu, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       Height="56"
                                       Margin="4,2"
                                       Stretch="Uniform"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Content="{Binding SidebarToggleText}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{Binding SidebarToggleToolTip}"
                                    Style="{StaticResource SidebarToggleButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding IrInicioCommand}"
                                ToolTip="Inicio">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE80F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="#60A5FA"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Inicio"
                                           Foreground="#111827"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SidebarCollapsedVisibility}" Margin="0,8,0,0">
                        <Grid Height="82">
                            <Image Source="{Binding IconoMenu, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                   Width="48"
                                   Height="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,2,0,0"
                                   Stretch="Uniform"/>
                            <Button Content="{Binding SidebarToggleText}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{Binding SidebarToggleToolTip}"
                                    Style="{StaticResource SidebarToggleButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,4"/>
                        </Grid>

                        <Button Command="{Binding IrInicioCommand}"
                                ToolTip="Inicio"
                                Style="{StaticResource CollapsedMenuButtonStyle}">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="#2563EB"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom"
                        Margin="10"
                        Padding="10"
                        Background="#F8FAFC"
                        CornerRadius="9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Visibility="{Binding SidebarExpandedVisibility}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" Background="#1D4ED8" CornerRadius="17" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario}" FontWeight="SemiBold" FontSize="12" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NombreRol}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cambiar clave" Command="{Binding CambiarClaveCommand}" Height="31" Margin="0,0,7,0" Background="#3B82F6" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Grid.Column="1" Command="{Binding CerrarSesionCommand}" Width="36" Height="31" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar sesión">
                                <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        Width="46"
                        Height="46"
                        Margin="0,0,0,12"
                        Background="#1D4ED8"
                        CornerRadius="23"
                        Visibility="{Binding SidebarCollapsedVisibility}"
                        ToolTip="Usuario">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,2,0,4"
                              Visibility="{Binding SidebarExpandedVisibility}">
                    <ItemsControl ItemsSource="{Binding SidebarMenus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding}"
                                          HeaderTemplate="{StaticResource SidebarModuleHeaderTemplate}"
                                          Foreground="#111827"
                                          Background="White"
                                          Margin="10,2"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="False">
                                    <ItemsControl ItemsSource="{Binding Hijos}" Margin="0,3,0,5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Titulo}"
                                                        Command="{Binding DataContext.IrVistaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Vista}"
                                                        Style="{StaticResource SubMenuButtonStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,4"
                              Visibility="{Binding SidebarCollapsedVisibility}">
                    <ItemsControl ItemsSource="{Binding SidebarMenus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button ToolTip="{Binding Titulo}"
                                        Tag="{Binding DataContext, ElementName=RootWindow}"
                                        Style="{StaticResource CollapsedMenuButtonStyle}"
                                        Click="CollapsedMenuButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding Hijos}"
                                                     Style="{StaticResource CollapsedContextMenuStyle}"
                                                     ItemContainerStyle="{StaticResource CollapsedContextMenuItemStyle}"/>
                                    </Button.ContextMenu>
                                    <TextBlock Text="{Binding Icono}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{Binding ColorIcono}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel x:Name="ListadoHerramientas" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CantidadItemsText" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Click="ExportarListado_Click" Height="36" MinWidth="100" Padding="14,0" Background="#16A34A" BorderBrush="#16A34A" Foreground="White" FontWeight="SemiBold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Exportar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="20" Background="White" CornerRadius="10">
                <ContentControl x:Name="ContenidoPrincipal" Content="{Binding VistaActual}"/>
            </Border>
        </Grid>
    </Grid>
</Window>